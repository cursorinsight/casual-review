#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  process-reviews [options] [REVIEWS_DIR]

Options:
  --engine NAME     codex, claude, or antigravity (default: codex)
  --reviews DIR     generated review directory (default: ai-reviews)
  --prompt FILE     prompt template (default: prompts/process-reviews.md)
  --model NAME      model override for the selected engine
  --effort LEVEL    reasoning-effort override for the selected engine
  --use-credits     allow metered API-credit billing
  -h, --help        show help

Environment overrides:
  CODEX_BIN, CLAUDE_BIN, ANTIGRAVITY_BIN
  CODEX_MODEL, CLAUDE_MODEL, ANTIGRAVITY_MODEL
  CODEX_EFFORT, CLAUDE_EFFORT, ANTIGRAVITY_EFFORT
  CODEX_EXTRA_ARGS, CLAUDE_EXTRA_ARGS, ANTIGRAVITY_EXTRA_ARGS
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "command not found: $1"
}

resolve_self() {
  local src=${BASH_SOURCE[0]}
  local dir

  while [[ -L "$src" ]]; do
    dir=$(CDPATH='' cd -- "$(dirname -- "$src")" && pwd -P)
    src=$(readlink "$src")
    [[ "$src" == /* ]] || src=$dir/$src
  done
  CDPATH='' cd -- "$(dirname -- "$src")" && pwd -P
}

cleanup() {
  if [[ -n "${PROMPT_TMP:-}" ]]; then
    rm -f -- "$PROMPT_TMP"
  fi
}

trap cleanup EXIT

SELF_DIR=$(resolve_self)
PACKAGE_DIR=$(CDPATH='' cd -- "$SELF_DIR/.." && pwd -P)
ENGINE=codex
REVIEWS_DIR=ai-reviews
PROMPT_FILE=$PACKAGE_DIR/prompts/process-reviews.md
MODEL_OPT=
EFFORT_OPT=
USE_CREDITS=0
PROMPT_TMP=
REPO_ROOT=
REVIEWS_DIR_ABS=

while (($#)); do
  case "$1" in
    --engine)
      [[ $# -ge 2 ]] || die "--engine needs a value"
      ENGINE=$2
      shift 2
      ;;
    --reviews)
      [[ $# -ge 2 ]] || die "--reviews needs a value"
      REVIEWS_DIR=$2
      shift 2
      ;;
    --prompt)
      [[ $# -ge 2 ]] || die "--prompt needs a value"
      PROMPT_FILE=$2
      shift 2
      ;;
    --model)
      [[ $# -ge 2 ]] || die "--model needs a value"
      MODEL_OPT=$2
      shift 2
      ;;
    --effort)
      [[ $# -ge 2 ]] || die "--effort needs a value"
      EFFORT_OPT=$2
      shift 2
      ;;
    --use-credits)
      USE_CREDITS=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ "$REVIEWS_DIR" == ai-reviews ]] ||
        die "only one reviews directory is supported"
      REVIEWS_DIR=$1
      shift
      ;;
  esac
done

case "$ENGINE" in
  codex|claude|antigravity) ;;
  *) die "invalid engine: $ENGINE" ;;
esac

if [[ -n "$MODEL_OPT" ]]; then
  case "$ENGINE" in
    codex) CODEX_MODEL=$MODEL_OPT ;;
    claude) CLAUDE_MODEL=$MODEL_OPT ;;
    antigravity) ANTIGRAVITY_MODEL=$MODEL_OPT ;;
  esac
fi
if [[ -n "$EFFORT_OPT" ]]; then
  case "$ENGINE" in
    codex) CODEX_EFFORT=$EFFORT_OPT ;;
    claude) CLAUDE_EFFORT=$EFFORT_OPT ;;
    antigravity) ANTIGRAVITY_EFFORT=$EFFORT_OPT ;;
  esac
fi

if ((USE_CREDITS == 0)); then
  unset ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY
fi

need git
[[ -r "$PROMPT_FILE" ]] || die "prompt not readable: $PROMPT_FILE"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  die "run inside a Git repository"

REPO_ROOT=$(git rev-parse --show-toplevel)
if [[ -d "$REVIEWS_DIR" ]]; then
  REVIEWS_DIR_ABS=$(CDPATH='' cd -- "$REVIEWS_DIR" && pwd -P)
elif [[ "$REVIEWS_DIR" != /* && -d "$REPO_ROOT/$REVIEWS_DIR" ]]; then
  REVIEWS_DIR_ABS=$(CDPATH='' cd -- "$REPO_ROOT/$REVIEWS_DIR" && pwd -P)
else
  die "not a directory: $REVIEWS_DIR"
fi
PROMPT_TMP=$(mktemp)

{
  printf 'Use these explicit inputs unless the user corrects them:\n\n'
  printf -- "- Review directory: \`%s\`\n" "$REVIEWS_DIR_ABS"
  printf -- "- Decision log: \`%s/DECISIONS.md\`\n\n" "$REVIEWS_DIR_ABS"
  printf 'Do not use a different review directory without asking.\n\n'
  cat "$PROMPT_FILE"
} >"$PROMPT_TMP"

reviews_outside_repo() {
  case "$REVIEWS_DIR_ABS/" in
    "$REPO_ROOT"/*) return 1 ;;
    *) return 0 ;;
  esac
}

run_codex() {
  local bin=${CODEX_BIN:-codex}
  local -a extra=() model=() effort=() add_dir=()

  need "$bin"
  [[ -z "${CODEX_EXTRA_ARGS:-}" ]] || read -r -a extra \
    <<<"${CODEX_EXTRA_ARGS:-}"
  [[ -z "${CODEX_MODEL:-}" ]] || model=(--model "$CODEX_MODEL")
  [[ -z "${CODEX_EFFORT:-}" ]] ||
    effort=(-c "model_reasoning_effort=\"$CODEX_EFFORT\"")
  reviews_outside_repo && add_dir=(--add-dir "$REVIEWS_DIR_ABS")
  "$bin" \
    -C "$REPO_ROOT" \
    --sandbox workspace-write \
    "${model[@]}" \
    "${effort[@]}" \
    "${add_dir[@]}" \
    "${extra[@]}" \
    "$(cat "$PROMPT_TMP")"
}

run_claude() {
  local bin=${CLAUDE_BIN:-claude}
  local -a extra=() model=() effort=()

  need "$bin"
  [[ -z "${CLAUDE_EXTRA_ARGS:-}" ]] || read -r -a extra \
    <<<"${CLAUDE_EXTRA_ARGS:-}"
  [[ -z "${CLAUDE_MODEL:-}" ]] || model=(--model "$CLAUDE_MODEL")
  [[ -z "${CLAUDE_EFFORT:-}" ]] || effort=(--effort "$CLAUDE_EFFORT")
  (
    cd "$REPO_ROOT"
    "$bin" "${model[@]}" "${effort[@]}" "${extra[@]}" \
      "$(cat "$PROMPT_TMP")"
  )
}

run_antigravity() {
  local bin=${ANTIGRAVITY_BIN:-antigravity}
  local -a extra=() model=() effort=() add_dir=()

  need "$bin"
  [[ -z "${ANTIGRAVITY_EXTRA_ARGS:-}" ]] || read -r -a extra \
    <<<"${ANTIGRAVITY_EXTRA_ARGS:-}"
  [[ -z "${ANTIGRAVITY_MODEL:-}" ]] || model=(--model "$ANTIGRAVITY_MODEL")
  [[ -z "${ANTIGRAVITY_EFFORT:-}" ]] ||
    effort=(--effort "$ANTIGRAVITY_EFFORT")
  reviews_outside_repo && add_dir=(--add-dir "$REVIEWS_DIR_ABS")
  (
    cd "$REPO_ROOT"
    "$bin" \
      --mode accept-edits \
      --prompt-interactive \
      "${model[@]}" \
      "${effort[@]}" \
      "${add_dir[@]}" \
      "${extra[@]}" \
      "$(cat "$PROMPT_TMP")"
  )
}

case "$ENGINE" in
  codex) run_codex ;;
  claude) run_claude ;;
  antigravity) run_antigravity ;;
esac
