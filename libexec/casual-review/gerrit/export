#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  casual-review gerrit export [options] [AI_REVIEWS_DIR]

Options:
  --output DIR     output directory
                   (default: AI_REVIEWS_DIR/gerrit-browser-upload)
  --engine NAME    only export reviews from AI_REVIEWS_DIR/NAME
                   use all to export every engine
                   (default: CASUAL_REVIEW_ENGINE or all engines)
  --limit N        process only the first N review files after filtering
  -h, --help       show help

Optional environment:
  CASUAL_REVIEW_ENGINE
                      engine filter; all selects every engine
  GERRIT_NOTIFY       NONE, OWNER, OWNER_REVIEWERS, or ALL (default: NONE)
  GERRIT_TAG          review tag (default: autogenerated:casual-review)
  GERRIT_LABELS_JSON  optional verdict-to-label mapping, e.g.
                      {"LGTM":{"Code-Review":1}}

Default arguments:
  AI_REVIEWS_DIR      ai-reviews
USAGE
}

[[ -n "${CASUAL_REVIEW_ROOT:-}" ]] || {
  printf 'Error: run this command through casual-review\n' >&2
  exit 1
}

# shellcheck source=lib/casual-review/common.sh
# shellcheck disable=SC1091
source "$CASUAL_REVIEW_ROOT/lib/casual-review/common.sh"

warn() {
  WARNINGS=$((WARNINGS + 1))
  printf 'Warning: %s\n' "$*" >&2
}

# shellcheck source=lib/casual-review/gerrit-upload.sh
# shellcheck disable=SC1091
source "$CASUAL_REVIEW_ROOT/lib/casual-review/gerrit-upload.sh"

cleanup() {
  if [[ -n "${TMP_DIR:-}" ]]; then
    rm -rf -- "$TMP_DIR"
  fi
}

trap cleanup EXIT

ENGINE_FILTER=${CASUAL_REVIEW_ENGINE:-}
LIMIT=0
OUTPUT_DIR=
REVIEW_DIR=
REVIEW_DIR_ARG_SET=0
TMP_DIR=
WARNINGS=0
TOTAL_REVIEWS=0
EXPORTED_REVIEWS=0
SKIPPED_REVIEWS=0
FAILED_REVIEWS=0
REVIEW_FILES=()
BUNDLE_COMMITS=()
BUNDLE_SHORTS=()
BUNDLE_FILES=()
BUNDLE_INDEX=

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
while (($#)); do
  case "$1" in
    --output)
      cli_require_value "$1" "${2-}" "$#"
      OUTPUT_DIR=$2
      shift 2
      ;;
    --engine)
      cli_require_value "$1" "${2-}" "$#"
      ENGINE_FILTER=$2
      shift 2
      ;;
    --limit)
      cli_require_value "$1" "${2-}" "$#"
      LIMIT=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      ((REVIEW_DIR_ARG_SET == 0)) ||
        die "only one AI_REVIEWS_DIR is supported"
      REVIEW_DIR=$1
      REVIEW_DIR_ARG_SET=1
      shift
      ;;
  esac
done

cli_validate_limit "$LIMIT"
fi

[[ "$ENGINE_FILTER" == all ]] && ENGINE_FILTER=

bundle_index_for_commit() {
  local commit=$1
  local short=${commit:0:7}
  local i=0

  while ((i < ${#BUNDLE_COMMITS[@]})); do
    if [[ "${BUNDLE_COMMITS[$i]}" == "$commit" ]]; then
      BUNDLE_INDEX=$i
      return 0
    fi
    if [[ "${BUNDLE_SHORTS[$i]}" == "$short" ]]; then
      die "short commit prefix collision: $short"
    fi
    i=$((i + 1))
  done

  BUNDLE_INDEX=-1
}

create_bundle() {
  local commit=$1
  local short=${commit:0:7}
  local file=$TMP_DIR/$short.json
  local created_at
  local idx

  created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  # shellcheck disable=SC2016
  write_file_from_command "$file" jq -c -n \
    --arg schema casual-review.gerrit-upload.v1 \
    --arg created_at "$created_at" \
    --arg source_directory "$REVIEW_DIR" \
    --arg commit "$commit" \
    --arg short "$short" \
    --arg tag "${GERRIT_TAG:-autogenerated:casual-review}" \
    --arg notify "${GERRIT_NOTIFY:-NONE}" '
      {
        schema: $schema,
        created_at: $created_at,
        source_directory: $source_directory,
        commit: $commit,
        commit_short: $short,
        tag: $tag,
        notify: $notify,
        omit_duplicate_comments: true,
        reviews: [],
        summary: {
          review_count: 0,
          comment_count: 0,
          verdict_count: 0
        }
      }
    ' || return 1

  idx=${#BUNDLE_COMMITS[@]}
  BUNDLE_COMMITS[idx]=$commit
  BUNDLE_SHORTS[idx]=$short
  BUNDLE_FILES[idx]=$file
  BUNDLE_INDEX=$idx
}

append_review_to_bundle() {
  local idx=$1
  local review_json=$2
  local current=${BUNDLE_FILES[$idx]}
  local next=$TMP_DIR/update.json

  # shellcheck disable=SC2016
  replace_file_from_filter "$current" "$next" \
    jq -c --argjson review "$review_json" '
    .reviews += [$review]
    | .summary.review_count = (.reviews | length)
    | .summary.comment_count = ([.reviews[].comments | length] | add // 0)
    | .summary.verdict_count = ([.reviews[] | select(.message != "")] |
        length)
  '
}

review_has_exportable_items() {
  local review_json=$1

  jq -e '
    ((.comments | length) > 0) or (.message != "")
  ' >/dev/null <<<"$review_json"
}

process_review_file() {
  local file=$1
  local idx
  local review_json

  if ! parse_review_file "$file"; then
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi
  TOTAL_REVIEWS=$((TOTAL_REVIEWS + 1))
  initialize_acceptance
  review_json=$(build_review_export_json "$file") || return 1

  if ! review_has_exportable_items "$review_json"; then
    printf 'Skipping %s: no comments or verdict.\n' "$file" >&2
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi

  bundle_index_for_commit "$REVIEW_COMMIT"
  idx=$BUNDLE_INDEX
  if [[ "$idx" == -1 ]]; then
    create_bundle "$REVIEW_COMMIT" || return 1
    idx=$BUNDLE_INDEX
  fi
  append_review_to_bundle "$idx" "$review_json" || return 1
  EXPORTED_REVIEWS=$((EXPORTED_REVIEWS + 1))
}

write_bundles() {
  local i=0
  local out
  local tmp_out

  mkdir -p "$OUTPUT_DIR" || return 1
  while ((i < ${#BUNDLE_FILES[@]})); do
    out=$OUTPUT_DIR/${BUNDLE_SHORTS[$i]}.json.gz
    tmp_out=$out.tmp
    replace_file_from_command "$out" "$tmp_out" \
      gzip -c "${BUNDLE_FILES[$i]}" || return 1
    printf 'Wrote %s\n' "$out"
    i=$((i + 1))
  done
}

main() {
  local file
  local engine

  if ((REVIEW_DIR_ARG_SET)); then
    [[ -n "$REVIEW_DIR" ]] || die "AI_REVIEWS_DIR must not be empty"
  else
    REVIEW_DIR=ai-reviews
  fi
  [[ -d "$REVIEW_DIR" ]] || die "not a directory: $REVIEW_DIR"
  [[ -n "$OUTPUT_DIR" ]] || OUTPUT_DIR=$REVIEW_DIR/gerrit-browser-upload

  need gzip
  validate_common_env
  TMP_DIR=$(mktemp -d)

  while IFS= read -r file; do
    engine=$(basename "$(dirname -- "$file")")
    if [[ -n "$ENGINE_FILTER" && "$engine" != "$ENGINE_FILTER" ]]; then
      continue
    fi
    if ((LIMIT > 0 && ${#REVIEW_FILES[@]} >= LIMIT)); then
      break
    fi
    REVIEW_FILES+=("$file")
  done < <(find "$REVIEW_DIR" \
    -type f -name '[0-9][0-9][0-9]-*.md' | sort)

  ((${#REVIEW_FILES[@]} > 0)) ||
    die "no review Markdown files found under $REVIEW_DIR"

  for file in "${REVIEW_FILES[@]}"; do
    if ! process_review_file "$file"; then
      FAILED_REVIEWS=$((FAILED_REVIEWS + 1))
    fi
  done

  write_bundles || return 1
  printf '\nReviews parsed: %s\n' "$TOTAL_REVIEWS"
  printf 'Reviews skipped: %s\n' "$SKIPPED_REVIEWS"
  printf 'Reviews exported: %s\n' "$EXPORTED_REVIEWS"
  printf 'Bundles written: %s\n' "${#BUNDLE_FILES[@]}"
  printf 'Warnings: %s\n' "$WARNINGS"
  printf 'Failures: %s\n' "$FAILED_REVIEWS"

  ((FAILED_REVIEWS == 0))
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main
fi
