#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  respond-gerrit-reviews [options] AI_REVIEWS_DIR DECISIONS_MD

Options:
  --dry-run        parse and print what would be posted; no HTTP (default)
  --interactive    ask before each Gerrit reply
  --yolo           post every matched decision automatically
  --limit N        process only the first N decision entries
  --self-test      run parser and JSON-builder checks, then exit
  -h, --help       show help

Required environment for --interactive and --yolo:
  GERRIT_URL              Gerrit base URL, e.g. https://gerrit.example.com
  GERRIT_USER             Gerrit username
  GERRIT_HTTP_PASSWORD    Gerrit HTTP password or token

Optional environment:
  GERRIT_PASSWORD         fallback when GERRIT_HTTP_PASSWORD is unset
  GERRIT_AUTH_TYPE        basic or digest (default: basic)
  GERRIT_NOTIFY           NONE, OWNER, OWNER_REVIEWERS, or ALL (default: NONE)
  GERRIT_RESPONSE_TAG     review tag
                          (default: autogenerated:casual-review-response)
  GERRIT_PROJECT          add project:... to change lookup queries
  GERRIT_BRANCH           add branch:... to change lookup queries
  GERRIT_QUERY_EXTRA      extra Gerrit query terms for change lookup
  GERRIT_ALLOW_NON_CURRENT=1
                          allow replies on old Gerrit patch sets
  GERRIT_CONNECT_TIMEOUT  curl connect timeout seconds (default: 10)
  GERRIT_MAX_TIME         curl total request timeout seconds (default: 120)
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

warn() {
  WARNINGS=$((WARNINGS + 1))
  printf 'Warning: %s\n' "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "command not found: $1"
}

cleanup() {
  if [[ -n "${CURL_AUTH_CONFIG:-}" ]]; then
    rm -f -- "$CURL_AUTH_CONFIG"
    CURL_AUTH_CONFIG=
  fi
}

trap cleanup EXIT

MODE=dry-run
LIMIT=0
SELF_TEST=0
REVIEW_DIR=
DECISIONS_FILE=
WARNINGS=0
TOTAL_DECISIONS=0
MATCHED_DECISIONS=0
CHANGE_MESSAGE_DECISIONS=0
DRY_RUN_RESPONSES=0
DRY_RUN_CHANGE_MESSAGES=0
POSTED_RESPONSES=0
POSTED_CHANGE_MESSAGES=0
SKIPPED_DECISIONS=0
DUPLICATE_CHANGE_MESSAGES=0
IGNORED_NO_COMMENTS=0
FAILED_RESPONSES=0

while (($#)); do
  case "$1" in
    --dry-run)
      MODE=dry-run
      shift
      ;;
    --interactive)
      MODE=interactive
      shift
      ;;
    --yolo)
      MODE=yolo
      shift
      ;;
    --limit)
      [[ $# -ge 2 ]] || die "--limit needs a value"
      LIMIT=$2
      shift 2
      ;;
    --self-test)
      SELF_TEST=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [[ -z "$REVIEW_DIR" ]]; then
        REVIEW_DIR=$1
      elif [[ -z "$DECISIONS_FILE" ]]; then
        DECISIONS_FILE=$1
      else
        die "too many positional arguments"
      fi
      shift
      ;;
  esac
done

[[ "$LIMIT" =~ ^[0-9]+$ ]] || die "--limit must be a non-negative integer"

DECISION_TITLES=()
DECISION_REVIEW_FILES=()
DECISION_REVIEWED_COMMITS=()
DECISION_VALUES=()
DECISION_FIX_COMMITS=()
DECISION_SQUASH_TARGETS=()
DECISION_CHECKS=()
DECISION_REASONINGS=()

REVIEW_COMMIT=
REVIEW_ENGINE=
COMMENT_PATHS=()
COMMENT_LINES=()
COMMENT_MESSAGES=()
COMMENT_SEVERITIES=()
COMMENT_TITLES=()
COMMENT_CONFIDENCES=()
COMMENT_ACTIONS=()
COMMENT_LOCATIONS=()

GERRIT_URL_EFFECTIVE=
CURL_AUTH_CONFIG=
CURL_AUTH_ARGS=()
CURL_TIMEOUT_ARGS=()
MATCH_COMMENT_ID=

strip_code_ticks() {
  local value=$1

  value=${value#\`}
  value=${value%\`}
  printf '%s' "$value"
}

normalize_full_commit_hash() {
  local value=$1

  value=$(strip_code_ticks "$value")
  value=$(printf '%s' "$value" | tr 'A-F' 'a-f')
  [[ "$value" =~ ^[0-9a-f]{40}$ ]] || return 1
  printf '%s' "$value"
}

append_value() {
  local current=$1
  local addition=$2

  if [[ -z "$current" ]]; then
    printf '%s' "$addition"
  else
    printf '%s %s' "$current" "$addition"
  fi
}

store_decision_field() {
  local field=$1
  local value=$2

  case "$field" in
    "Review file")
      CURRENT_REVIEW_FILE=$(strip_code_ticks "$value")
      ;;
    "Reviewed commit")
      CURRENT_REVIEWED_COMMIT=$(strip_code_ticks "$value")
      ;;
    "Decision")
      CURRENT_DECISION=$value
      ;;
    "Fix commit")
      CURRENT_FIX_COMMIT=$value
      ;;
    "Squash target")
      CURRENT_SQUASH_TARGET=$value
      ;;
    "Checks")
      CURRENT_CHECKS=$value
      ;;
    "Reasoning")
      CURRENT_REASONING=$value
      ;;
  esac
}

append_decision_continuation() {
  local field=$1
  local value=$2

  case "$field" in
    "Review file")
      CURRENT_REVIEW_FILE=$(append_value "$CURRENT_REVIEW_FILE" "$value")
      ;;
    "Reviewed commit")
      CURRENT_REVIEWED_COMMIT=$(
        append_value "$CURRENT_REVIEWED_COMMIT" "$value"
      )
      ;;
    "Decision")
      CURRENT_DECISION=$(append_value "$CURRENT_DECISION" "$value")
      ;;
    "Fix commit")
      CURRENT_FIX_COMMIT=$(append_value "$CURRENT_FIX_COMMIT" "$value")
      ;;
    "Squash target")
      CURRENT_SQUASH_TARGET=$(
        append_value "$CURRENT_SQUASH_TARGET" "$value"
      )
      ;;
    "Checks")
      CURRENT_CHECKS=$(append_value "$CURRENT_CHECKS" "$value")
      ;;
    "Reasoning")
      CURRENT_REASONING=$(append_value "$CURRENT_REASONING" "$value")
      ;;
  esac
}

reset_current_decision() {
  CURRENT_TITLE=
  CURRENT_REVIEW_FILE=
  CURRENT_REVIEWED_COMMIT=
  CURRENT_DECISION=
  CURRENT_FIX_COMMIT=
  CURRENT_SQUASH_TARGET=
  CURRENT_CHECKS=
  CURRENT_REASONING=
  CURRENT_FIELD=
}

finish_current_decision() {
  local idx

  [[ -n "$CURRENT_TITLE" ]] || return 0

  idx=${#DECISION_TITLES[@]}
  DECISION_TITLES[idx]=$CURRENT_TITLE
  DECISION_REVIEW_FILES[idx]=$CURRENT_REVIEW_FILE
  DECISION_REVIEWED_COMMITS[idx]=$CURRENT_REVIEWED_COMMIT
  DECISION_VALUES[idx]=$CURRENT_DECISION
  DECISION_FIX_COMMITS[idx]=$CURRENT_FIX_COMMIT
  DECISION_SQUASH_TARGETS[idx]=$CURRENT_SQUASH_TARGET
  DECISION_CHECKS[idx]=$CURRENT_CHECKS
  DECISION_REASONINGS[idx]=$CURRENT_REASONING
}

parse_decisions_file() {
  local file=$1
  local line
  local heading_re='^## ([^[:space:]]+) - ([0-9a-fA-F]{7,40}) - (.*)$'
  local value

  reset_current_decision
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ $line =~ $heading_re ]]; then
      finish_current_decision
      reset_current_decision
      CURRENT_TITLE=${BASH_REMATCH[3]}
      continue
    fi

    case "$line" in
      "- Review file: "*)
        CURRENT_FIELD="Review file"
        value=${line#"- Review file: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Reviewed commit: "*)
        CURRENT_FIELD="Reviewed commit"
        value=${line#"- Reviewed commit: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Decision: "*)
        CURRENT_FIELD="Decision"
        value=${line#"- Decision: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Fix commit: "*)
        CURRENT_FIELD="Fix commit"
        value=${line#"- Fix commit: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Squash target: "*)
        CURRENT_FIELD="Squash target"
        value=${line#"- Squash target: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Checks: "*)
        CURRENT_FIELD="Checks"
        value=${line#"- Checks: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "- Reasoning: "*)
        CURRENT_FIELD="Reasoning"
        value=${line#"- Reasoning: "}
        store_decision_field "$CURRENT_FIELD" "$value"
        ;;
      "  "*)
        if [[ -n "$CURRENT_FIELD" ]]; then
          value=${line#  }
          append_decision_continuation "$CURRENT_FIELD" "$value"
        fi
        ;;
      "")
        CURRENT_FIELD=
        ;;
    esac
  done <"$file"
  finish_current_decision
}

normalize_text() {
  printf '%s' "$1" |
    tr '\n' ' ' |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[`*]//g; s/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

tokenize_text() {
  printf '%s' "$1" |
    tr '\n' ' ' |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]/ /g; s/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

is_noise_token() {
  case "$1" in
    a|an|and|are|as|at|be|been|being|but|by|can|could|did|do|does|for)
      return 0
      ;;
    from|had|has|have|in|into|is|it|its|new|not|of|on|only|or|per)
      return 0
      ;;
    should|still|than|that|the|then|this|to|was|were|when|while|with|would)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

significant_overlap() {
  local haystack_raw=$1
  local needle_raw=$2
  local haystack
  local needle
  local token
  local unique_tokens=
  local seen=0
  local hits=0

  haystack=$(tokenize_text "$haystack_raw")
  needle=$(tokenize_text "$needle_raw")
  [[ -n "$haystack" && -n "$needle" ]] || return 1

  for token in $needle; do
    is_noise_token "$token" && continue
    ((${#token} >= 3)) || continue
    case " $unique_tokens " in
      *" $token "*) continue ;;
    esac
    unique_tokens="$unique_tokens $token"
    seen=$((seen + 1))
    case " $haystack " in
      *" $token "*) hits=$((hits + 1)) ;;
    esac
  done

  ((seen > 0)) || return 1
  ((hits >= 3)) && return 0
  ((seen <= 2 && hits == seen))
}

extract_decision_finding() {
  local reasoning=$1
  local finding

  case "$reasoning" in
    "Finding: "*". Original measure:"*)
      finding=${reasoning#Finding: }
      finding=${finding%%. Original measure:*}
      printf '%s' "$finding"
      ;;
    *)
      printf '%s' "$reasoning"
      ;;
  esac
}

reset_review() {
  REVIEW_COMMIT=
  REVIEW_ENGINE=
  COMMENT_PATHS=()
  COMMENT_LINES=()
  COMMENT_MESSAGES=()
  COMMENT_SEVERITIES=()
  COMMENT_TITLES=()
  COMMENT_CONFIDENCES=()
  COMMENT_ACTIONS=()
  COMMENT_LOCATIONS=()
}

append_finding_comment_line() {
  local line=$1

  if [[ -z "$FINDING_COMMENT" ]]; then
    FINDING_COMMENT=$line
  else
    FINDING_COMMENT+=$'\n'"$line"
  fi
}

parse_location_span() {
  local span=$1
  local path_line_re='^(.+):([0-9]+)([-,][0-9,-]*)?$'

  LOCATION_PATH=
  LOCATION_LINE=
  if [[ $span =~ $path_line_re ]]; then
    LOCATION_PATH=${BASH_REMATCH[1]}
    LOCATION_LINE=${BASH_REMATCH[2]}
    return 0
  fi

  case "$span" in
    */*|*.*)
      LOCATION_PATH=$span
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

parse_location_text() {
  local text=$1
  local rest=$1
  local span
  local fallback_re='([^[:space:],()]+):([0-9]+)'
  local line_hint_re='line[[:space:]]+([0-9]+)'

  PARSED_LOCATION_PATH=
  PARSED_LOCATION_LINE=
  while [[ $rest == *\`* ]]; do
    rest=${rest#*\`}
    [[ $rest == *\`* ]] || break
    span=${rest%%\`*}
    rest=${rest#"$span"}
    rest=${rest#\`}

    parse_location_span "$span" || continue
    if [[ -n "$LOCATION_LINE" ]]; then
      PARSED_LOCATION_PATH=$LOCATION_PATH
      PARSED_LOCATION_LINE=$LOCATION_LINE
      return 0
    fi
    [[ -n "$PARSED_LOCATION_PATH" ]] || PARSED_LOCATION_PATH=$LOCATION_PATH
  done

  if [[ -n "$PARSED_LOCATION_PATH" ]]; then
    if [[ $text =~ $line_hint_re ]]; then
      PARSED_LOCATION_LINE=${BASH_REMATCH[1]}
    fi
    return 0
  fi

  if [[ $text =~ $fallback_re ]]; then
    PARSED_LOCATION_PATH=${BASH_REMATCH[1]}
    PARSED_LOCATION_LINE=${BASH_REMATCH[2]}
    return 0
  fi
  return 1
}

finish_comment() {
  local idx

  if ((HAVE_FINDING == 0 || COMMENT_STORED == 1)); then
    return 0
  fi
  COMMENT_STORED=1
  if [[ -z "$FINDING_COMMENT" || -z "$FINDING_PATH" ]]; then
    return 0
  fi

  idx=${#COMMENT_PATHS[@]}
  COMMENT_PATHS[idx]=$FINDING_PATH
  COMMENT_LINES[idx]=$FINDING_LINE
  COMMENT_MESSAGES[idx]=$FINDING_COMMENT
  COMMENT_SEVERITIES[idx]=$FINDING_SEVERITY
  COMMENT_TITLES[idx]=$FINDING_TITLE
  COMMENT_CONFIDENCES[idx]=$FINDING_CONFIDENCE
  COMMENT_ACTIONS[idx]=$FINDING_ACTION
  COMMENT_LOCATIONS[idx]=$FINDING_LOCATION
}

start_finding() {
  FINDING_SEVERITY=$1
  FINDING_TITLE=$2
  FINDING_CONFIDENCE=
  FINDING_PATH=
  FINDING_LINE=
  FINDING_ACTION=
  FINDING_COMMENT=
  FINDING_LOCATION=
  HAVE_FINDING=1
  COMMENT_STORED=0
  COLLECT_COMMENT=0
}

parse_review_file() {
  local file=$1
  local line
  local in_findings=0
  local commit_re heading_re location_re confidence_re action_re engine_re
  local location_text

  reset_review
  REVIEW_ENGINE=$(basename "$(dirname -- "$file")")
  HAVE_FINDING=0
  COMMENT_STORED=0
  COLLECT_COMMENT=0
  FINDING_SEVERITY=
  FINDING_TITLE=
  FINDING_CONFIDENCE=
  FINDING_PATH=
  FINDING_LINE=
  FINDING_ACTION=
  FINDING_COMMENT=
  FINDING_LOCATION=

  commit_re="^(- )?Commit: \`([0-9A-Fa-f]{40})\`"
  heading_re='^### \[([^]]+)\] (.*)$'
  location_re='^- Location: (.*)$'
  confidence_re='^- Confidence: (.*)$'
  action_re='^- Gerrit action: (.*)$'
  engine_re='^_Engine: ([^[:space:]]+)'

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ $line =~ $commit_re ]]; then
      REVIEW_COMMIT=$(printf '%s' "${BASH_REMATCH[2]}" | tr 'A-F' 'a-f')
      continue
    fi
    if [[ $line =~ $engine_re ]]; then
      REVIEW_ENGINE=${BASH_REMATCH[1]}
      continue
    fi

    case "$line" in
      "## Findings")
        in_findings=1
        continue
        ;;
      "## Questions"|"## Positive observations"|"## Review verdict"|"---")
        finish_comment
        in_findings=0
        COLLECT_COMMENT=0
        continue
        ;;
    esac

    if ((in_findings)); then
      if [[ $line =~ $heading_re ]]; then
        finish_comment
        start_finding "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        continue
      fi
      ((HAVE_FINDING == 1)) || continue
      if ((COLLECT_COMMENT)); then
        if [[ $line == ">" ]]; then
          append_finding_comment_line ""
        elif [[ $line == "> "* ]]; then
          append_finding_comment_line "${line#> }"
        elif [[ -n "$line" ]]; then
          COLLECT_COMMENT=0
        fi
        continue
      fi
      if [[ $line =~ $confidence_re ]]; then
        FINDING_CONFIDENCE=${BASH_REMATCH[1]}
      elif [[ $line =~ $location_re ]]; then
        location_text=${BASH_REMATCH[1]}
        FINDING_LOCATION=$location_text
        if parse_location_text "$location_text"; then
          FINDING_PATH=$PARSED_LOCATION_PATH
          FINDING_LINE=$PARSED_LOCATION_LINE
        fi
      elif [[ $line =~ $action_re ]]; then
        FINDING_ACTION=${BASH_REMATCH[1]}
      elif [[ $line == "Suggested Gerrit comment:" ]]; then
        COLLECT_COMMENT=1
      fi
    fi
  done <"$file"

  finish_comment
  [[ -n "$REVIEW_COMMIT" ]]
}

format_original_comment() {
  local i=$1
  local msg title severity confidence action short location

  title=${COMMENT_TITLES[$i]:-}
  severity=${COMMENT_SEVERITIES[$i]:-}
  confidence=${COMMENT_CONFIDENCES[$i]:-}
  action=${COMMENT_ACTIONS[$i]:-}
  location=${COMMENT_LOCATIONS[$i]:-}
  short=${REVIEW_COMMIT:0:12}

  msg="**[AI/${REVIEW_ENGINE}] ${severity}:**"
  [[ -z "$title" ]] || msg+=" $title"
  [[ -z "$confidence" ]] || msg+=$'\n'"**Confidence:** $confidence"
  [[ -z "$action" ]] || msg+=$'\n'"**Action:** $action"
  [[ -z "$location" ]] || msg+=$'\n'"**Location:** $location"
  msg+=$'\n'"**Commit:** $short"
  msg+=$'\n\n'"${COMMENT_MESSAGES[$i]}"
  printf '%s' "$msg"
}

review_comment_matches_finding() {
  local normalized_finding=$1
  local normalized_title=$2
  local normalized_body=$3

  [[ -n "$normalized_title" ]] || return 1
  if [[ "$normalized_finding" == *"$normalized_title"* ||
      "$normalized_title" == *"$normalized_finding"* ||
      "$normalized_finding" == *"$normalized_body"* ]]; then
    return 0
  fi
  significant_overlap "$normalized_finding" "$normalized_title"
}

matching_review_comment_index() {
  local decision_reasoning=$1
  local finding
  local normalized_finding
  local normalized_title
  local normalized_body
  local i=0
  local match=-1
  local matches=0

  finding=$(extract_decision_finding "$decision_reasoning")
  normalized_finding=$(normalize_text "$finding")
  while ((i < ${#COMMENT_TITLES[@]})); do
    normalized_title=$(normalize_text "${COMMENT_TITLES[$i]:-}")
    normalized_body=$(normalize_text "${COMMENT_MESSAGES[$i]:-}")
    if review_comment_matches_finding \
        "$normalized_finding" \
        "$normalized_title" \
        "$normalized_body"; then
      match=$i
      matches=$((matches + 1))
    fi
    i=$((i + 1))
  done

  if ((matches == 1)); then
    printf '%s' "$match"
    return 0
  fi
  return 1
}

resolve_review_file() {
  local file=$1
  local base
  local match
  local found=
  local count=0

  if [[ -f "$file" ]]; then
    printf '%s' "$file"
    return 0
  fi
  if [[ -f "$REVIEW_DIR/$file" ]]; then
    printf '%s' "$REVIEW_DIR/$file"
    return 0
  fi

  base=$(basename -- "$file")
  while IFS= read -r match; do
    found=$match
    count=$((count + 1))
  done < <(find "$REVIEW_DIR" -type f -name "$base")

  if ((count == 1)); then
    printf '%s' "$found"
    return 0
  fi
  return 1
}

decision_resolves_thread() {
  case "$1" in
    *[Ff]ix*|*[Ss]kip*)
      printf 'true'
      ;;
    *)
      printf 'false'
      ;;
  esac
}

build_response_message() {
  local i=$1
  local decision=${DECISION_VALUES[$i]}
  local fix_commit=${DECISION_FIX_COMMITS[$i]:-none}
  local squash_target=${DECISION_SQUASH_TARGETS[$i]:-none}
  local checks=${DECISION_CHECKS[$i]:-not run: no checks recorded}
  local reasoning=${DECISION_REASONINGS[$i]:-}
  local resolved
  local message

  resolved=$(decision_resolves_thread "$decision")
  message="**Decision:** $decision"
  message+=$'\n'"**Fix commit:** $fix_commit"
  message+=$'\n'"**Squash target:** $squash_target"
  message+=$'\n'"**Resolved:** $resolved"
  message+=$'\n'"**Checks:** $checks"
  [[ -z "$reasoning" ]] || message+=$'\n\n'"$reasoning"
  printf '%s' "$message"
}

curl_config_escape() {
  local value=$1

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

create_curl_auth_config() {
  local user=$1
  local password=$2
  local config

  case "$user$password" in
    *$'\n'*|*$'\r'*)
      die "Gerrit credentials must not contain newlines"
      ;;
  esac
  case "$user" in
    *:*)
      die "GERRIT_USER must not contain ':'"
      ;;
  esac

  cleanup
  config=$(mktemp) || die "failed to create temporary curl config"
  chmod 600 "$config" || {
    rm -f -- "$config"
    die "failed to restrict temporary curl config permissions"
  }

  if ! {
    printf 'user = "'
    curl_config_escape "$user"
    printf ':'
    curl_config_escape "$password"
    printf '"\n'
  } >"$config"; then
    rm -f -- "$config"
    die "failed to write temporary curl config"
  fi

  CURL_AUTH_CONFIG=$config
}

validate_common_env() {
  local notify=${GERRIT_NOTIFY:-NONE}

  need jq
  case "$notify" in
    NONE|OWNER|OWNER_REVIEWERS|ALL) ;;
    *) die "GERRIT_NOTIFY must be NONE, OWNER, OWNER_REVIEWERS, or ALL" ;;
  esac
}

validate_curl_timeouts() {
  local connect_timeout=${GERRIT_CONNECT_TIMEOUT:-10}
  local max_time=${GERRIT_MAX_TIME:-120}

  [[ "$connect_timeout" =~ ^[1-9][0-9]*$ ]] ||
    die "GERRIT_CONNECT_TIMEOUT must be a positive integer"
  [[ "$max_time" =~ ^[1-9][0-9]*$ ]] ||
    die "GERRIT_MAX_TIME must be a positive integer"

  CURL_TIMEOUT_ARGS=(
    --connect-timeout "$connect_timeout"
    --max-time "$max_time"
  )
}

validate_gerrit_env() {
  local auth_type=${GERRIT_AUTH_TYPE:-basic}
  local password

  validate_common_env
  need curl
  [[ -n "${GERRIT_URL:-}" ]] || die "GERRIT_URL is required"
  [[ -n "${GERRIT_USER:-}" ]] || die "GERRIT_USER is required"
  password=${GERRIT_HTTP_PASSWORD:-${GERRIT_PASSWORD:-}}
  [[ -n "$password" ]] ||
    die "GERRIT_HTTP_PASSWORD or GERRIT_PASSWORD is required"

  GERRIT_URL_EFFECTIVE=${GERRIT_URL%/}
  case "$auth_type" in
    basic|digest) ;;
    *) die "GERRIT_AUTH_TYPE must be basic or digest" ;;
  esac
  validate_curl_timeouts
  create_curl_auth_config "$GERRIT_USER" "$password"
  unset GERRIT_HTTP_PASSWORD GERRIT_PASSWORD
  password=

  case "$auth_type" in
    basic)
      CURL_AUTH_ARGS=(--config "$CURL_AUTH_CONFIG")
      ;;
    digest)
      CURL_AUTH_ARGS=(--config "$CURL_AUTH_CONFIG" --digest)
      ;;
  esac
}

strip_xssi_file() {
  local file=$1
  local first

  IFS= read -r first <"$file" || return 0
  if [[ "$first" == ")]}'" ]]; then
    sed '1d' "$file"
  else
    cat "$file"
  fi
}

change_query() {
  local commit=$1
  local query

  query="commit:$commit"
  [[ -z "${GERRIT_PROJECT:-}" ]] || query+=" project:${GERRIT_PROJECT}"
  [[ -z "${GERRIT_BRANCH:-}" ]] || query+=" branch:${GERRIT_BRANCH}"
  [[ -z "${GERRIT_QUERY_EXTRA:-}" ]] || query+=" ${GERRIT_QUERY_EXTRA}"
  printf '%s' "$query"
}

gerrit_get_json() {
  local url=$1
  local output
  local status

  output=$(mktemp)
  if ! status=$(
    curl -sS -w '%{http_code}' -o "$output" \
      "${CURL_AUTH_ARGS[@]}" \
      "${CURL_TIMEOUT_ARGS[@]}" \
      -H 'Accept: application/json' \
      "$url"
  ); then
    rm -f "$output"
    return 1
  fi

  case "$status" in
    2*) ;;
    *)
      strip_xssi_file "$output" >&2
      rm -f "$output"
      return 1
      ;;
  esac
  strip_xssi_file "$output"
  rm -f "$output"
}

gerrit_query_changes() {
  local query=$1
  local output
  local status
  local url

  output=$(mktemp)
  url="$GERRIT_URL_EFFECTIVE/a/changes/"
  if ! status=$(
    curl -sS -w '%{http_code}' -o "$output" \
      "${CURL_AUTH_ARGS[@]}" \
      "${CURL_TIMEOUT_ARGS[@]}" \
      -H 'Accept: application/json' \
      --get "$url" \
      --data-urlencode "q=$query" \
      --data-urlencode 'n=2' \
      --data-urlencode 'o=CURRENT_REVISION' \
      --data-urlencode 'pp=0'
  ); then
    rm -f "$output"
    warn "Gerrit change query failed for: $query"
    return 1
  fi

  case "$status" in
    2*) ;;
    *)
      warn "Gerrit change query returned HTTP $status for: $query"
      strip_xssi_file "$output" >&2
      rm -f "$output"
      return 1
      ;;
  esac
  strip_xssi_file "$output"
  rm -f "$output"
}

gerrit_find_change() {
  local commit=$1
  local query
  local json
  local count

  query=$(change_query "$commit")
  json=$(gerrit_query_changes "$query") || return 1
  if ! count=$(jq 'length' <<<"$json"); then
    warn "invalid Gerrit JSON response for query: $query"
    return 1
  fi
  if ((count == 0)); then
    warn "no Gerrit change found for query: $query"
    return 1
  fi
  if ((count > 1)); then
    warn "multiple Gerrit changes found for query: $query"
    warn "set GERRIT_PROJECT, GERRIT_BRANCH, or GERRIT_QUERY_EXTRA"
    return 1
  fi
  jq -r '.[0] | [._number, (.current_revision // "")] | @tsv' <<<"$json"
}

gerrit_list_comments() {
  local change_number=$1
  local revision=$2
  local url

  url="$GERRIT_URL_EFFECTIVE/a/changes/$change_number"
  url="$url/revisions/$revision/comments/"
  gerrit_get_json "$url" || {
    warn "Gerrit comment list failed for change $change_number"
    return 1
  }
}

gerrit_list_messages() {
  local change_number=$1
  local url

  url="$GERRIT_URL_EFFECTIVE/a/changes/$change_number/messages"
  gerrit_get_json "$url" || {
    warn "Gerrit message list failed for change $change_number"
    return 1
  }
}

message_matches() {
  local candidate=$1
  local expected=$2
  local title=$3
  local body=$4
  local candidate_norm
  local expected_first
  local expected_norm
  local title_norm
  local body_norm

  candidate_norm=$(normalize_text "$candidate")
  expected_first=${expected%%$'\n'*}
  expected_norm=$(normalize_text "$expected_first")
  title_norm=$(normalize_text "$title")
  body_norm=$(normalize_text "$body")

  [[ -n "$expected_norm" && "$candidate_norm" == *"$expected_norm"* ]] &&
    return 0
  [[ -n "$title_norm" && "$candidate_norm" == *"$title_norm"* ]] &&
    return 0
  [[ -n "$body_norm" && "$candidate_norm" == *"$body_norm"* ]] &&
    return 0
  return 1
}

thread_has_response() {
  local comments_json=$1
  local root_id=$2
  local tag=${GERRIT_RESPONSE_TAG:-autogenerated:casual-review-response}

  jq -e --arg root "$root_id" --arg tag "$tag" '
    [
      to_entries[] | .value[] |
      select((.in_reply_to // "") == $root and (.tag // "") == $tag)
    ] | length > 0
  ' >/dev/null <<<"$comments_json"
}

change_message_exists() {
  local messages_json=$1
  local marker=$2
  local tag=${GERRIT_RESPONSE_TAG:-autogenerated:casual-review-response}

  jq -e --arg tag "$tag" --arg marker "$marker" '
    [
      .[] |
      select((.tag // "") == $tag) |
      select((.message // "") | contains($marker))
    ] | length > 0
  ' >/dev/null <<<"$messages_json"
}

find_remote_comment() {
  local comments_json=$1
  local path=$2
  local line=$3
  local expected=$4
  local title=$5
  local body=$6
  local candidate
  local id
  local message
  local matches=0

  MATCH_COMMENT_ID=
  while IFS= read -r candidate; do
    id=$(jq -r '.id // ""' <<<"$candidate")
    message=$(jq -r '.message // ""' <<<"$candidate")
    if message_matches "$message" "$expected" "$title" "$body"; then
      MATCH_COMMENT_ID=$id
      matches=$((matches + 1))
    fi
  done < <(
    jq -c --arg path "$path" --arg line "$line" '
      to_entries[] |
      select(.key == $path) |
      .value[] |
      select((.in_reply_to // "") == "") |
      select(
        ($line == "" and ((has("line") | not) or .line == 0)) or
        ($line != "" and ((.line // 0) | tostring) == $line)
      )
    ' <<<"$comments_json"
  )

  ((matches == 1))
}

build_change_message_payload() {
  local message=$1
  local tag=${GERRIT_RESPONSE_TAG:-autogenerated:casual-review-response}
  local notify=${GERRIT_NOTIFY:-NONE}

  jq -c -n \
    --arg tag "$tag" \
    --arg notify "$notify" \
    --arg message "$message" \
    '{tag: $tag, notify: $notify, message: $message}'
}

build_response_payload() {
  local path=$1
  local line=$2
  local in_reply_to=$3
  local message=$4
  local unresolved=$5
  local tag=${GERRIT_RESPONSE_TAG:-autogenerated:casual-review-response}
  local notify=${GERRIT_NOTIFY:-NONE}

  if [[ -n "$line" ]]; then
    jq -c -n \
      --arg tag "$tag" \
      --arg notify "$notify" \
      --arg path "$path" \
      --arg message "$message" \
      --arg in_reply_to "$in_reply_to" \
      --argjson line "$line" \
      --argjson unresolved "$unresolved" '
        {
          tag: $tag,
          notify: $notify,
          omit_duplicate_comments: true,
          comments: {
            ($path): [{
              line: $line,
              in_reply_to: $in_reply_to,
              message: $message,
              unresolved: $unresolved
            }]
          }
        }
      '
  else
    jq -c -n \
      --arg tag "$tag" \
      --arg notify "$notify" \
      --arg path "$path" \
      --arg message "$message" \
      --arg in_reply_to "$in_reply_to" \
      --argjson unresolved "$unresolved" '
        {
          tag: $tag,
          notify: $notify,
          omit_duplicate_comments: true,
          comments: {
            ($path): [{
              in_reply_to: $in_reply_to,
              message: $message,
              unresolved: $unresolved
            }]
          }
        }
      '
  fi
}

gerrit_post_response() {
  local change_number=$1
  local revision=$2
  local payload=$3
  local output
  local payload_file
  local status
  local url

  output=$(mktemp)
  payload_file=$(mktemp)
  printf '%s' "$payload" >"$payload_file"
  url="$GERRIT_URL_EFFECTIVE/a/changes/$change_number"
  url="$url/revisions/$revision/review"

  if ! status=$(
    curl -sS -w '%{http_code}' -o "$output" \
      "${CURL_AUTH_ARGS[@]}" \
      "${CURL_TIMEOUT_ARGS[@]}" \
      -H 'Accept: application/json' \
      -H 'Content-Type: application/json; charset=UTF-8' \
      -X POST \
      --data-binary "@$payload_file" \
      "$url"
  ); then
    rm -f "$output" "$payload_file"
    warn "Gerrit response POST failed for change $change_number"
    return 1
  fi

  rm -f "$payload_file"
  case "$status" in
    2*) ;;
    *)
      warn "Gerrit response POST returned HTTP $status" \
        "for change $change_number"
      strip_xssi_file "$output" >&2
      rm -f "$output"
      return 1
      ;;
  esac
  strip_xssi_file "$output" >/dev/null
  rm -f "$output"
}

confirm() {
  local prompt=$1
  local answer

  prompt=${prompt%\?}
  while true; do
    printf '%s? [y] post / [N] skip: ' "$prompt" >&9
    IFS= read -r answer <&9 || return 1
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      ""|n|N|no|NO) return 1 ;;
      *) printf 'Enter y or n.\n' >&9 ;;
    esac
  done
}

print_response_preview() {
  local i=$1
  local review_file=$2
  local comment_index=$3
  local response=$4
  local line

  line=${COMMENT_LINES[$comment_index]:-}
  printf '\nDecision %s/%s\n' "$((i + 1))" "${#DECISION_TITLES[@]}"
  printf '  Review file: %s\n' "$review_file"
  printf '  Commit: %s\n' "${DECISION_REVIEWED_COMMITS[$i]}"
  if [[ -n "$line" ]]; then
    printf '  Comment: %s:%s\n' "${COMMENT_PATHS[$comment_index]}" "$line"
  else
    printf '  Comment: %s\n' "${COMMENT_PATHS[$comment_index]}"
  fi
  printf '  Title: %s\n' "${COMMENT_TITLES[$comment_index]}"
  printf '  Decision: %s\n' "${DECISION_VALUES[$i]}"
  printf '  Response:\n'
  printf '%s\n' "$response" | sed 's/^/    | /'
}

decision_marker() {
  local i=$1

  printf 'casual-review-decision:%s:%s' \
    "${DECISION_REVIEWED_COMMITS[$i]}" \
    "${DECISION_TITLES[$i]}"
}

build_change_message() {
  local i=$1
  local marker=$2
  local response
  local message

  response=$(build_response_message "$i")
  message="**AI review decision without inline comment:**"
  message+=$'\n'"**Decision key:** $marker"
  message+=$'\n'"**Review file:** ${DECISION_REVIEW_FILES[$i]}"
  message+=$'\n'"**Reviewed commit:** ${DECISION_REVIEWED_COMMITS[$i]}"
  message+=$'\n\n'"$response"
  printf '%s' "$message"
}

print_change_message_preview() {
  local i=$1
  local review_file=$2
  local message=$3

  printf '\nDecision %s/%s\n' "$((i + 1))" "${#DECISION_TITLES[@]}"
  printf '  Review file: %s\n' "$review_file"
  printf '  Commit: %s\n' "${DECISION_REVIEWED_COMMITS[$i]}"
  printf '  Change message: yes\n'
  printf '  Decision: %s\n' "${DECISION_VALUES[$i]}"
  printf '  Message:\n'
  printf '%s\n' "$message" | sed 's/^/    | /'
}

process_decision() {
  local i=$1
  local review_file
  local comment_index
  local response
  local expected
  local unresolved
  local change_info
  local change_number
  local current_revision
  local comments_json
  local messages_json
  local payload
  local line
  local marker
  local prompt
  local tab
  local decision_commit

  TOTAL_DECISIONS=$((TOTAL_DECISIONS + 1))
  if [[ -z "${DECISION_REVIEW_FILES[$i]:-}" ||
      -z "${DECISION_REVIEWED_COMMITS[$i]:-}" ]]; then
    warn "decision $((i + 1)): missing review file or commit"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi
  if ! review_file=$(resolve_review_file "${DECISION_REVIEW_FILES[$i]}"); then
    warn "decision $((i + 1)): review file not found"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi
  if ! parse_review_file "$review_file"; then
    warn "$review_file: no review commit metadata"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi
  if ! decision_commit=$(
      normalize_full_commit_hash "${DECISION_REVIEWED_COMMITS[$i]}"
    ); then
    warn "decision $((i + 1)): Reviewed commit is not a full commit hash"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi
  DECISION_REVIEWED_COMMITS[i]=$decision_commit
  if [[ "$REVIEW_COMMIT" != "$decision_commit" ]]; then
    warn "decision $((i + 1)): review file commit does not match decision"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi
  if ((${#COMMENT_PATHS[@]} == 0)); then
    IGNORED_NO_COMMENTS=$((IGNORED_NO_COMMENTS + 1))
    return 0
  fi
  if comment_index=$(
      matching_review_comment_index "${DECISION_REASONINGS[$i]}"
    ); then
    response=$(build_response_message "$i")
    print_response_preview "$i" "$review_file" "$comment_index" "$response"
  else
    marker=$(decision_marker "$i")
    response=$(build_change_message "$i" "$marker")
    print_change_message_preview "$i" "$review_file" "$response"
  fi

  if [[ "$MODE" == dry-run ]]; then
    if [[ -n "${comment_index:-}" ]]; then
      DRY_RUN_RESPONSES=$((DRY_RUN_RESPONSES + 1))
      MATCHED_DECISIONS=$((MATCHED_DECISIONS + 1))
    else
      DRY_RUN_CHANGE_MESSAGES=$((DRY_RUN_CHANGE_MESSAGES + 1))
      CHANGE_MESSAGE_DECISIONS=$((CHANGE_MESSAGE_DECISIONS + 1))
    fi
    return 0
  fi
  if [[ "$MODE" == interactive ]]; then
    if [[ -n "${comment_index:-}" ]]; then
      prompt="Post this Gerrit response"
    else
      prompt="Post this Gerrit change message"
    fi
    if ! confirm "$prompt"; then
      SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
      return 0
    fi
  fi

  change_info=$(gerrit_find_change "${DECISION_REVIEWED_COMMITS[$i]}") ||
    return 1
  tab=$'\t'
  change_number=${change_info%%"$tab"*}
  current_revision=${change_info#*"$tab"}
  if [[ "$current_revision" == "$change_info" ]]; then
    current_revision=
  fi

  if [[ -n "$current_revision" &&
      "$current_revision" != "${DECISION_REVIEWED_COMMITS[$i]}" ]]; then
    if [[ "${GERRIT_ALLOW_NON_CURRENT:-0}" != 1 ]]; then
      warn "$review_file: reviewed commit is not the current Gerrit revision"
      warn "set GERRIT_ALLOW_NON_CURRENT=1 to post to old patch sets"
      return 1
    fi
    warn "$review_file: replying on non-current patch set" \
      "${DECISION_REVIEWED_COMMITS[$i]}"
  fi

  if [[ -z "${comment_index:-}" ]]; then
    messages_json=$(gerrit_list_messages "$change_number") || return 1
    if change_message_exists "$messages_json" "$marker"; then
      DUPLICATE_CHANGE_MESSAGES=$((DUPLICATE_CHANGE_MESSAGES + 1))
      SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
      return 0
    fi
    payload=$(build_change_message_payload "$response") || return 1
    gerrit_post_response \
      "$change_number" \
      "${DECISION_REVIEWED_COMMITS[$i]}" \
      "$payload" || return 1
    POSTED_CHANGE_MESSAGES=$((POSTED_CHANGE_MESSAGES + 1))
    CHANGE_MESSAGE_DECISIONS=$((CHANGE_MESSAGE_DECISIONS + 1))
    return 0
  fi

  comments_json=$(
    gerrit_list_comments "$change_number" "${DECISION_REVIEWED_COMMITS[$i]}"
  ) || return 1

  expected=$(format_original_comment "$comment_index")
  line=${COMMENT_LINES[$comment_index]:-}
  if ! find_remote_comment \
      "$comments_json" \
      "${COMMENT_PATHS[$comment_index]}" \
      "$line" \
      "$expected" \
      "${COMMENT_TITLES[$comment_index]}" \
      "${COMMENT_MESSAGES[$comment_index]}"; then
    warn "no unique uploaded Gerrit comment found for $review_file"
    return 1
  fi
  if thread_has_response "$comments_json" "$MATCH_COMMENT_ID"; then
    warn "response already exists for Gerrit comment $MATCH_COMMENT_ID"
    SKIPPED_DECISIONS=$((SKIPPED_DECISIONS + 1))
    return 0
  fi

  unresolved=$(decision_resolves_thread "${DECISION_VALUES[$i]}")
  if [[ "$unresolved" == true ]]; then
    unresolved=false
  else
    unresolved=true
  fi
  payload=$(
    build_response_payload \
      "${COMMENT_PATHS[$comment_index]}" \
      "$line" \
      "$MATCH_COMMENT_ID" \
      "$response" \
      "$unresolved"
  ) || return 1

  gerrit_post_response \
    "$change_number" \
    "${DECISION_REVIEWED_COMMITS[$i]}" \
    "$payload" || return 1
  POSTED_RESPONSES=$((POSTED_RESPONSES + 1))
  MATCHED_DECISIONS=$((MATCHED_DECISIONS + 1))
}

run_self_test() {
  local tmp
  local reviews
  local review_file
  local empty_review_file
  local decisions
  local comment_index
  local expected
  local comments_json
  local response
  local payload
  local marker

  tmp=$(mktemp -d)
  reviews="$tmp/reviews"
  mkdir -p "$reviews/codex"
  review_file="$reviews/codex/001-0123456789ab.md"
  empty_review_file="$reviews/codex/002-fedcba987654.md"
  decisions="$tmp/DECISIONS.md"
  cat >"$review_file" <<'EOF_REVIEW'
# Commit review

## Commit

- Commit: `0123456789abcdef0123456789abcdef01234567`
- Parent: `1111111111111111111111111111111111111111`
- Subject: Add response script

## Findings

### [Major] Validate input

- Confidence: High
- Location: `bin/tool:42`
- Introduced by this commit: Yes
- Gerrit action: Must fix

Suggested Gerrit comment:

> Please reject empty input before sending the request.

### [Minor] Update docs

- Confidence: Medium
- Location: `README.md`
- Introduced by this commit: Yes
- Gerrit action: Consider

Suggested Gerrit comment:

> Explain the new mode in the README.

## Questions

None.
EOF_REVIEW
  cat >"$empty_review_file" <<'EOF_EMPTY_REVIEW'
# Commit review

## Commit

- Commit: `fedcba9876543210fedcba9876543210fedcba98`
- Parent: `1111111111111111111111111111111111111111`
- Subject: Empty review

## Findings

None.

## Questions

None.
EOF_EMPTY_REVIEW
  cat >"$decisions" <<EOF_DECISIONS
## 2026-08-07T00:00:00Z - 0123456789ab - Validate input

- Review file: \`$review_file\`
- Reviewed commit: \`0123456789abcdef0123456789abcdef01234567\`
- Decision: Fix
- Fix commit: \`abcdef1\`
- Squash target: \`0123456789abcdef0123456789abcdef01234567\`
- Checks: \`shellcheck bin/tool\` passed
- Reasoning: Finding: Validate input. Original measure: Fix. Added guard.

## 2026-08-07T00:00:00Z - 0123456789ab - Follow-up question

- Review file: \`$review_file\`
- Reviewed commit: \`0123456789abcdef0123456789abcdef01234567\`
- Decision: Skip
- Fix commit: none
- Squash target: none
- Checks: not run: no checks recorded
- Reasoning: Finding: Reviewer asked a non-inline question. Original measure:
  Skip. No uploaded inline comment exists.

## 2026-08-07T00:00:00Z - 0123456789ab - Update docs

- Review file: \`$review_file\`
- Reviewed commit: \`0123456789abcdef0123456789abcdef01234567\`
- Decision: Skip
- Fix commit: none
- Squash target: none
- Checks: not run: no checks recorded
- Reasoning: Finding: Update docs. Original measure: Skip. The README already
  explains the command.

## 2026-08-07T00:00:00Z - fedcba987654 - Empty review

- Review file: \`$empty_review_file\`
- Reviewed commit: \`fedcba9876543210fedcba9876543210fedcba98\`
- Decision: Skip
- Fix commit: none
- Squash target: none
- Checks: not run: no checks recorded
- Reasoning: Finding: Review failed without reviewer comments. Original
  measure: No action. Nothing should be uploaded.

## 2026-08-07T00:00:00Z - 222222222222 - Wrong commit

- Review file: \`$review_file\`
- Reviewed commit: \`2222222222222222222222222222222222222222\`
- Decision: Skip
- Fix commit: none
- Squash target: none
- Checks: not run: no checks recorded
- Reasoning: Finding: Stale decision metadata. Original measure: Skip.
  Mismatched review files must not be posted.
EOF_DECISIONS

  parse_decisions_file "$decisions"
  [[ ${#DECISION_TITLES[@]} -eq 5 ]] ||
    die "self-test: decision count failed"
  parse_review_file "$review_file" ||
    die "self-test: review parse failed"
  [[ ${#COMMENT_PATHS[@]} -eq 2 ]] ||
    die "self-test: interleaved review comment count failed"
  comment_index=$(matching_review_comment_index "${DECISION_REASONINGS[0]}") ||
    die "self-test: first comment matching failed"
  [[ "$comment_index" == 0 ]] ||
    die "self-test: wrong first comment index"
  if matching_review_comment_index "${DECISION_REASONINGS[1]}" >/dev/null;
  then
    die "self-test: non-inline decision matched a comment"
  fi
  comment_index=$(matching_review_comment_index "${DECISION_REASONINGS[2]}") ||
    die "self-test: second comment matching failed"
  [[ "$comment_index" == 1 ]] ||
    die "self-test: wrong second comment index"
  parse_review_file "$empty_review_file" ||
    die "self-test: empty review parse failed"
  ((${#COMMENT_PATHS[@]} == 0)) ||
    die "self-test: empty review comment count failed"
  parse_review_file "$review_file" ||
    die "self-test: review reparse failed"
  comment_index=$(matching_review_comment_index "${DECISION_REASONINGS[0]}") ||
    die "self-test: comment matching failed"
  [[ "$comment_index" == 0 ]] ||
    die "self-test: wrong comment index"

  DRY_RUN_RESPONSES=0
  DRY_RUN_CHANGE_MESSAGES=0
  MATCHED_DECISIONS=0
  CHANGE_MESSAGE_DECISIONS=0
  process_decision 1 >/dev/null ||
    die "self-test: non-inline decision processing failed"
  process_decision 2 >/dev/null ||
    die "self-test: interleaved inline decision processing failed"
  [[ "$DRY_RUN_CHANGE_MESSAGES" == 1 ]] ||
    die "self-test: non-inline decision not converted to change message"
  [[ "$DRY_RUN_RESPONSES" == 1 ]] ||
    die "self-test: interleaved inline decision not matched"

  expected=$(format_original_comment "$comment_index")
  comments_json=$(
    jq -c -n \
      --arg message "${expected//\*\*/}" \
      '{"bin/tool": [{id: "abc123", line: 42, message: $message}]}'
  )
  find_remote_comment \
    "$comments_json" \
    "bin/tool" \
    "42" \
    "$expected" \
    "Validate input" \
    "Please reject empty input before sending the request." ||
    die "self-test: remote comment matching failed"
  [[ "$MATCH_COMMENT_ID" == abc123 ]] ||
    die "self-test: remote comment id failed"

  response=$(build_response_message 0)
  payload=$(
    build_response_payload "bin/tool" "42" "abc123" "$response" false
  )
  jq -e '
    .comments["bin/tool"][0].in_reply_to == "abc123"
    and .comments["bin/tool"][0].unresolved == false
    and (.comments["bin/tool"][0].message | contains("**Decision:** Fix"))
    and (.comments["bin/tool"][0].message | contains("Added guard."))
  ' >/dev/null <<<"$payload" || die "self-test: response payload failed"

  marker=$(decision_marker 1)
  response=$(build_change_message 1 "$marker")
  payload=$(build_change_message_payload "$response")
  jq -e --arg marker "$marker" '
    .message | contains($marker)
  ' >/dev/null <<<"$payload" ||
    die "self-test: change message payload failed"
  change_message_exists \
    "$(jq -c -n --arg message "$response" '
      [{tag: "autogenerated:casual-review-response", message: $message}]
    ')" \
    "$marker" ||
    die "self-test: change message duplicate check failed"

  IGNORED_NO_COMMENTS=0
  process_decision 3 >/dev/null ||
    die "self-test: empty review decision processing failed"
  [[ "$IGNORED_NO_COMMENTS" == 1 ]] ||
    die "self-test: empty review decision not ignored"

  SKIPPED_DECISIONS=0
  process_decision 4 >/dev/null 2>/dev/null ||
    die "self-test: mismatched commit processing failed"
  [[ "$SKIPPED_DECISIONS" == 1 ]] ||
    die "self-test: mismatched commit not skipped"

  rm -rf "$tmp"
  printf 'self-test ok\n'
}

main() {
  local i=0

  if ((SELF_TEST)); then
    validate_common_env
    run_self_test
    return 0
  fi

  [[ -n "$REVIEW_DIR" ]] || die "AI_REVIEWS_DIR is required"
  [[ -n "$DECISIONS_FILE" ]] || die "DECISIONS_MD is required"
  [[ -d "$REVIEW_DIR" ]] || die "not a directory: $REVIEW_DIR"
  [[ -r "$DECISIONS_FILE" ]] || die "not readable: $DECISIONS_FILE"

  validate_common_env
  if [[ "$MODE" != dry-run ]]; then
    validate_gerrit_env
  fi
  if [[ "$MODE" == interactive ]]; then
    (: <>/dev/tty) 2>/dev/null ||
      die "--interactive requires an attached terminal at /dev/tty"
    exec 9<>/dev/tty
  fi

  parse_decisions_file "$DECISIONS_FILE"
  (( ${#DECISION_TITLES[@]} > 0 )) ||
    die "no decision entries found in $DECISIONS_FILE"

  while ((i < ${#DECISION_TITLES[@]})); do
    if ((LIMIT > 0 && TOTAL_DECISIONS >= LIMIT)); then
      break
    fi
    if ! process_decision "$i"; then
      FAILED_RESPONSES=$((FAILED_RESPONSES + 1))
    fi
    i=$((i + 1))
  done

  if [[ "$MODE" == interactive ]]; then
    exec 9>&-
  fi
  printf '\nDecisions parsed: %s\n' "$TOTAL_DECISIONS"
  printf 'Inline responses matched: %s\n' "$MATCHED_DECISIONS"
  printf 'Change messages matched: %s\n' "$CHANGE_MESSAGE_DECISIONS"
  printf 'Decisions ignored with no review comments: %s\n' \
    "$IGNORED_NO_COMMENTS"
  printf 'Decisions skipped: %s\n' "$SKIPPED_DECISIONS"
  if [[ "$MODE" == dry-run ]]; then
    printf 'Dry-run responses: %s\n' "$DRY_RUN_RESPONSES"
    printf 'Dry-run change messages: %s\n' "$DRY_RUN_CHANGE_MESSAGES"
  else
    printf 'Responses posted: %s\n' "$POSTED_RESPONSES"
    printf 'Change messages posted: %s\n' "$POSTED_CHANGE_MESSAGES"
    printf 'Duplicate change messages: %s\n' "$DUPLICATE_CHANGE_MESSAGES"
  fi
  printf 'Warnings: %s\n' "$WARNINGS"
  printf 'Failures: %s\n' "$FAILED_RESPONSES"

  ((FAILED_RESPONSES == 0))
}

main
