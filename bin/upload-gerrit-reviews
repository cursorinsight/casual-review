page_template_tail() {
  cat <<'EOF_PAGE_TAIL'
</script>
<script>
(function () {
'use strict';

async function postReviews(job) {
  const base = window.CANONICAL_PATH || '';
  const raw = document.cookie.split(/;\s*/).filter(
    (part) => part.indexOf('XSRF_TOKEN=') === 0)[0];
  if (!raw) {
    throw new Error(
      'XSRF_TOKEN cookie missing; open a signed-in Gerrit page first');
  }
  const token = decodeURIComponent(raw.slice('XSRF_TOKEN='.length));
  const parse = (text) => JSON.parse(text.replace(/^\)\]\}'[^\n]*\n/, ''));
  const get = async (path) => {
    const res = await fetch(base + path, {
      credentials: 'same-origin',
      headers: {Accept: 'application/json'},
    });
    if (!res.ok) {
      throw new Error('GET ' + path + ' returned HTTP ' + res.status);
    }
    return parse(await res.text());
  };
  let posted = 0;
  let skipped = 0;
  let failed = 0;

  for (const review of job.reviews) {
    const label = review.engine + ' ' + review.commit.slice(0, 12);
    try {
      const found = await get('/changes/?q=' +
        encodeURIComponent(review.query) +
        '&n=2&o=CURRENT_REVISION&pp=0');
      if (found.length === 0) {
        throw new Error('no change matches query: ' + review.query);
      }
      if (found.length > 1) {
        throw new Error('multiple changes match query: ' + review.query);
      }
      const change = found[0];
      if (change.current_revision &&
          change.current_revision !== review.commit &&
          !job.allow_non_current) {
        console.warn('skip ' + label + ': change ' + change._number +
          ' has a newer patch set');
        skipped += 1;
        continue;
      }
      const payload = {
        tag: job.tag,
        notify: job.notify,
        omit_duplicate_comments: true,
      };
      if (review.comments.length > 0) {
        const comments = {};
        for (const item of review.comments) {
          const entry = {
            message: item.message,
            unresolved: item.unresolved,
          };
          if (item.line !== null) {
            entry.line = item.line;
          }
          if (!comments[item.path]) {
            comments[item.path] = [];
          }
          comments[item.path].push(entry);
        }
        payload.comments = comments;
      }
      if (review.message) {
        const messages = await get(
          '/changes/' + change._number + '/messages');
        const seen = messages.some((entry) =>
          (entry.tag || '') === job.tag &&
          (entry.message || '').indexOf(review.marker) !== -1 &&
          (entry.message || '').indexOf(review.verdict) !== -1);
        if (seen) {
          console.info('skip verdict for ' + label + ': already posted');
        } else {
          payload.message = review.message;
          if (Object.keys(review.labels).length > 0) {
            payload.labels = review.labels;
          }
        }
      }
      if (!payload.comments && !payload.message) {
        console.info('skip ' + label + ': nothing left to post');
        skipped += 1;
        continue;
      }
      const res = await fetch(base + '/changes/' + change._number +
        '/revisions/' + review.commit + '/review', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json; charset=UTF-8',
          'X-Gerrit-Auth': token,
        },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const detail = (await res.text()).slice(0, 200);
        throw new Error(
          'POST returned HTTP ' + res.status + ': ' + detail);
      }
      console.log('posted ' + label + ' to change ' + change._number);
      posted += 1;
    } catch (error) {
      console.error('failed ' + label + ': ' + error.message);
      failed += 1;
    }
  }

  const summary = {posted: posted, skipped: skipped, failed: failed};
  console.log('casual-review: ' + JSON.stringify(summary));
  return summary;
}

const job = JSON.parse(
  document.getElementById('casual-review-job').textContent);
const container = document.getElementById('reviews');
const snippetBox = document.getElementById('snippet');
const statusBox = document.getElementById('status');

const el = (tag, cls, text) => {
  const node = document.createElement(tag);
  if (cls) { node.className = cls; }
  if (text !== undefined) { node.textContent = text; }
  return node;
};

const boxId = (kind, r, c) =>
  'sel-' + kind + '-' + r + (c === undefined ? '' : '-' + c);

const checked = (id) => {
  const node = document.getElementById(id);
  return Boolean(node && node.checked);
};

const sevClass = (severity) => {
  if (severity === 'Critical' || severity === 'Major' ||
      severity === 'Minor') {
    return 'sev sev-' + severity;
  }
  return 'sev sev-other';
};

const allIndexes = () => job.reviews.map((review, r) => r);

function setStatus(text) {
  statusBox.textContent = text;
}

function collect(indexes) {
  const reviews = [];

  indexes.forEach((r) => {
    const review = job.reviews[r];
    const comments = [];
    review.comments.forEach((comment, c) => {
      if (!checked(boxId('c', r, c))) { return; }
      comments.push({
        path: comment.path,
        line: comment.line,
        message: comment.message,
        unresolved: comment.unresolved,
      });
    });
    const verdict = Boolean(review.message) && checked(boxId('v', r));
    if (comments.length === 0 && !verdict) { return; }
    reviews.push({
      engine: review.engine,
      commit: review.commit,
      query: review.query,
      marker: review.marker,
      verdict: review.verdict,
      message: verdict ? review.message : '',
      labels: verdict ? review.labels : {},
      comments: comments,
    });
  });

  return {
    tag: job.tag,
    notify: job.notify,
    allow_non_current: job.allow_non_current,
    reviews: reviews,
  };
}

function buildSnippet(indexes) {
  const data = collect(indexes);

  if (data.reviews.length === 0) { return ''; }
  return '(' + postReviews.toString() + ')(' +
    JSON.stringify(data) + ');';
}

async function copySnippet(indexes) {
  const text = buildSnippet(indexes);
  let ok = false;

  if (!text) {
    snippetBox.value = '';
    setStatus('Nothing selected.');
    return;
  }
  snippetBox.value = text;
  snippetBox.focus();
  snippetBox.select();
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      ok = true;
    }
  } catch (error) {
    ok = false;
  }
  if (!ok) {
    try {
      ok = document.execCommand('copy');
    } catch (error) {
      ok = false;
    }
  }
  setStatus(ok
    ? 'Copied. Paste it into the Gerrit DevTools console.'
    : 'Copy failed; select the text above and copy it manually.');
}

function refresh() {
  const data = collect(allIndexes());
  const where = job.url ? job.url : 'your Gerrit server';
  let comments = 0;
  let verdicts = 0;

  data.reviews.forEach((review) => {
    comments += review.comments.length;
    if (review.message) { verdicts += 1; }
  });
  document.getElementById('intro').textContent =
    'Selected ' + comments + ' inline comment(s) and ' + verdicts +
    ' verdict(s) across ' + data.reviews.length + ' change(s). ' +
    'Target: ' + where + ' · tag: ' + job.tag +
    ' · notify: ' + job.notify + '.';
}

function setAll(value) {
  container.querySelectorAll('input[type=checkbox]').forEach((box) => {
    box.checked = value;
  });
  refresh();
}

function renderChoice(kind, r, c, severity, where, title, body) {
  const wrap = el('div', 'item');
  const label = el('label');
  const box = el('input');

  box.type = 'checkbox';
  box.id = boxId(kind, r, c);
  box.checked = true;
  box.addEventListener('change', refresh);
  label.appendChild(box);
  label.appendChild(el('span', sevClass(severity), severity));
  label.appendChild(el('code', '', where));
  if (title) { label.appendChild(el('span', '', title)); }
  wrap.appendChild(label);
  wrap.appendChild(el('pre', 'body', body));
  return wrap;
}

function renderReview(review, r) {
  const card = el('section', 'review');
  const copy = el('button', '', 'Copy snippet for this change');

  card.appendChild(el('h2', '',
    review.engine + ' — ' + (review.subject || review.commit)));
  card.appendChild(el('p', 'meta', review.commit.slice(0, 12) +
    ' · ' + review.query + ' · ' + review.file));

  if (review.message) {
    card.appendChild(renderChoice('v', r, undefined, 'Verdict',
      review.verdict, '', review.message));
  }
  review.comments.forEach((comment, c) => {
    const where = comment.line === null
      ? comment.path
      : comment.path + ':' + comment.line;
    card.appendChild(renderChoice('c', r, c,
      comment.severity || 'Finding', where, comment.title,
      comment.message));
  });
  if (review.comments.length === 0 && !review.message) {
    card.appendChild(el('p', 'empty', 'Nothing to post.'));
  }

  copy.type = 'button';
  copy.addEventListener('click', () => copySnippet([r]));
  card.appendChild(copy);
  return card;
}

job.reviews.forEach((review, r) => {
  container.appendChild(renderReview(review, r));
});
if (job.reviews.length === 0) {
  container.appendChild(el('p', 'empty', 'No reviews were staged.'));
}
document.getElementById('copy-all').addEventListener(
  'click', () => copySnippet(allIndexes()));
document.getElementById('tick-all').addEventListener(
  'click', () => setAll(true));
document.getElementById('untick-all').addEventListener(
  'click', () => setAll(false));
refresh();
}());
</script>
</body>
</html>
EOF_PAGE_TAIL
}

write_page() {
  local job=$1
  local out=$2

  {
    page_template_head
    printf '%s\n' "$job" | page_json_escape
    page_template_tail
  } >"$out"
}

validate_page_target() {
  local dir

  [[ ! -d "$PAGE_FILE" ]] || die "--page target is a directory: $PAGE_FILE"
  dir=$(dirname -- "$PAGE_FILE")
  [[ -d "$dir" ]] || die "not a directory: $dir"
  [[ -w "$dir" ]] || die "directory is not writable: $dir"
  [[ ! -e "$PAGE_FILE" || -w "$PAGE_FILE" ]] ||
    die "file is not writable: $PAGE_FILE"
}

stage_page_review() {
  local file=$1
  local review

  if ((${#COMMENT_PATHS[@]} == 0)) && [[ -z "$REVIEW_VERDICT" ]]; then
    printf 'Skipping %s: no comments or verdict.\n' "$file" >&2
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi

  review=$(page_review_json "$file") || return 1
  PAGE_REVIEWS+=("$review")
  STAGED_REVIEWS=$((STAGED_REVIEWS + 1))
}

write_page_file() {
  local job
  local reviews='[]'

  if ((${#PAGE_REVIEWS[@]} > 0)); then
    reviews=$(printf '%s\n' "${PAGE_REVIEWS[@]}" | jq -s -c '.') || return 1
  fi
  job=$(page_job_json "$reviews") || return 1
  write_page "$job" "$PAGE_FILE" ||
    die "failed to write approval page: $PAGE_FILE"
  printf 'Wrote approval page: %s\n' "$PAGE_FILE"
}

print_dry_run() {
  local file=$1
  local payload=$2
  local i=0
  local count
  local labels

  count=$(selected_comment_count)

  printf '\nDRY-RUN %s\n' "$file"
  printf '  commit: %s\n' "${REVIEW_COMMIT:0:7}"
  printf '  query: %s\n' "$(change_query "${REVIEW_COMMIT:0:7}")"
  printf '  engine: %s\n' "$REVIEW_ENGINE"
  printf '  inline comments: %s\n' "$count"

  if [[ -n "$REVIEW_VERDICT" && "$ACCEPT_JUDGEMENT" == 1 ]]; then
    printf '  verdict: %s\n' "$REVIEW_VERDICT"
  fi

  labels=$(jq -c '.labels // {}' <<<"$payload") || return 1
  if [[ "$labels" != "{}" ]]; then
    printf '  labels: %s\n' "$labels"
  fi

  while ((i < ${#COMMENT_PATHS[@]})); do
    if [[ ${ACCEPT_COMMENTS[$i]:-0} == 1 ]]; then
      printf '  comment: %s\n' "$(comment_location "$i")"
      format_comment "$i" | sed 's/^/    | /'
      printf '\n'
    fi
    i=$((i + 1))
  done
}

payload_is_empty() {
  local payload=$1

  jq -e '
    (has("message") or has("comments") or has("labels")) | not
  ' >/dev/null <<<"$payload"
}

process_review() {
  local file=$1
  local comments_json
  local labels_json
  local message
  local messages_json
  local payload
  local change_info
  local change_number
  local current_revision
  local tab

  if ! parse_review_file "$file"; then
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi
  TOTAL_REVIEWS=$((TOTAL_REVIEWS + 1))
  initialize_acceptance

  if [[ "$MODE" == page ]]; then
    stage_page_review "$file"
    return $?
  fi

  if [[ "$MODE" == interactive ]]; then
    INTERACTIVE_INDEX=$((INTERACTIVE_INDEX + 1))
    tui_review_header "$file"
    interactive_select
  fi

  comments_json=$(build_comments_json) || return 1
  message=$(build_review_message) || return 1
  if [[ "$ACCEPT_JUDGEMENT" == 1 ]]; then
    labels_json=$(labels_for_verdict "$REVIEW_VERDICT") || return 1
  else
    labels_json='{}'
  fi
  payload=$(build_review_json "$comments_json" "$labels_json" "$message") ||
    return 1

  if payload_is_empty "$payload"; then
    printf 'Skipping %s: no accepted comments or verdict.\n' "$file" >&2
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi

  if [[ "$MODE" == dry-run ]]; then
    print_dry_run "$file" "$payload" || return 1
    DRY_RUN_REVIEWS=$((DRY_RUN_REVIEWS + 1))
    return 0
  fi

  change_info=$(gerrit_find_change "$REVIEW_COMMIT") || return 1
  tab=$'\t'
  change_number=${change_info%%"$tab"*}
  current_revision=${change_info#*"$tab"}
  if [[ "$current_revision" == "$change_info" ]]; then
    current_revision=
  fi

  if [[ -n "$current_revision" &&
      "$current_revision" != "$REVIEW_COMMIT" ]]; then
    if [[ "${GERRIT_ALLOW_NON_CURRENT:-0}" != 1 ]]; then
      warn "$file: reviewed commit is not the current Gerrit revision"
      warn "set GERRIT_ALLOW_NON_CURRENT=1 to post to old patch sets"
      return 1
    fi
    warn "$file: posting to non-current patch set $REVIEW_COMMIT"
  fi

  comments_json=$(gerrit_list_comments "$change_number" "$REVIEW_COMMIT") ||
    return 1
  filter_duplicate_comments "$comments_json" || return 1
  comments_json=$(build_comments_json) || return 1

  if [[ -n "$message" ]]; then
    messages_json=$(gerrit_list_messages "$change_number") || return 1
    if review_message_already_posted \
        "$messages_json" \
        "$(review_message_marker "$REVIEW_ENGINE" "${REVIEW_COMMIT:0:7}")" \
        "$REVIEW_VERDICT"; then
      message=
      labels_json='{}'
      DUPLICATE_MESSAGES=$((DUPLICATE_MESSAGES + 1))
    fi
  fi

  payload=$(build_review_json "$comments_json" "$labels_json" "$message") ||
    return 1
  if payload_is_empty "$payload"; then
    printf 'Skipping %s: already posted to Gerrit.\n' "$file" >&2
    SKIPPED_REVIEWS=$((SKIPPED_REVIEWS + 1))
    return 0
  fi

  gerrit_post_review "$change_number" "$REVIEW_COMMIT" "$payload" ||
    return 1
  printf 'Posted %s to Gerrit change %s.\n' "$file" "$change_number"
  POSTED_REVIEWS=$((POSTED_REVIEWS + 1))
}

main() {
  local file
  local engine
  local summary_body

  [[ -n "$REVIEW_DIR" ]] || die "AI_REVIEWS_DIR is required"
  [[ -d "$REVIEW_DIR" ]] || die "not a directory: $REVIEW_DIR"

  validate_common_env
  if [[ "$MODE" == page ]]; then
    validate_page_target
  elif [[ "$MODE" != dry-run ]]; then
    validate_gerrit_env
  fi
  if [[ "$MODE" == interactive ]]; then
    (: <>/dev/tty) 2>/dev/null ||
      die "--interactive requires an attached terminal at /dev/tty"
    exec 9<>/dev/tty
    TUI_ACTIVE=1
    tui_setup
  fi

  while IFS= read -r file; do
    engine=$(basename "$(dirname -- "$file")")
    if [[ -n "$ENGINE_FILTER" && "$engine" != "$ENGINE_FILTER" ]]; then
      continue
    fi
    if ((LIMIT > 0 && ${#REVIEW_FILES[@]} >= LIMIT)); then
      break
    fi
    REVIEW_FILES+=("$file")
  done < <(find "$REVIEW_DIR" \
    -type f -name '[0-9][0-9][0-9]-*.md' | sort)

  INTERACTIVE_TOTAL=${#REVIEW_FILES[@]}
  ((INTERACTIVE_TOTAL > 0)) ||
    die "no review Markdown files found under $REVIEW_DIR"

  if [[ "$MODE" == interactive ]]; then
    tui_banner "$(tui_progress_bar 0 "$INTERACTIVE_TOTAL")"
  fi

  for file in "${REVIEW_FILES[@]}"; do
    if ! process_review "$file"; then
      FAILED_REVIEWS=$((FAILED_REVIEWS + 1))
    fi
  done

  if [[ "$MODE" == page ]] && ! write_page_file; then
    FAILED_REVIEWS=$((FAILED_REVIEWS + 1))
  fi

  if [[ "$MODE" == interactive ]]; then
    summary_body="Reviews parsed: $TOTAL_REVIEWS"
    summary_body+=$'\n'"Reviews skipped: $SKIPPED_REVIEWS"
    summary_body+=$'\n'"Reviews posted: $POSTED_REVIEWS"
    summary_body+=$'\n'"Duplicate comments: $DUPLICATE_COMMENTS"
    summary_body+=$'\n'"Duplicate messages: $DUPLICATE_MESSAGES"
    summary_body+=$'\n'"Warnings: $WARNINGS"
    summary_body+=$'\n'"Failures: $FAILED_REVIEWS"
    tui_box "Run summary" info "$summary_body"
    TUI_ACTIVE=0
    exec 9>&-
  else
    printf '\nReviews parsed: %s\n' "$TOTAL_REVIEWS"
    printf 'Reviews skipped: %s\n' "$SKIPPED_REVIEWS"
    if [[ "$MODE" == dry-run ]]; then
      printf 'Dry-run payloads: %s\n' "$DRY_RUN_REVIEWS"
    elif [[ "$MODE" == page ]]; then
      printf 'Reviews staged: %s\n' "$STAGED_REVIEWS"
    else
      printf 'Reviews posted: %s\n' "$POSTED_REVIEWS"
      printf 'Duplicate comments: %s\n' "$DUPLICATE_COMMENTS"
      printf 'Duplicate messages: %s\n' "$DUPLICATE_MESSAGES"
    fi
    printf 'Warnings: %s\n' "$WARNINGS"
    printf 'Failures: %s\n' "$FAILED_REVIEWS"
  fi

  ((FAILED_REVIEWS == 0))
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main
fi
