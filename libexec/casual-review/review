#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  casual-review review [options]

Options:
  --engine NAME       codex, claude, antigravity, or all
                      (default: CASUAL_REVIEW_ENGINE or codex)
  --base REF          base ref
                      (default: detected origin/master or origin/main)
  --head REF          head ref (default: HEAD)
  --output DIR        output directory (default: ai-reviews)
  --prompt FILE       commit prompt template
  --limit N           review only the first N commits
  --model NAME        model override (requires a single --engine, not "all")
  --effort LEVEL      reasoning-effort override (requires a single --engine,
                      not "all"); valid levels are engine-specific
  --use-credits       allow metered API-credit billing instead of the
                      engine's default plan/subscription auth (default: off;
                      verified to control this for claude, best-effort for
                      codex/antigravity -- see README)
  --skip-summary      do not create an aggregate summary
  -h, --help          show help

Environment overrides:
  CASUAL_REVIEW_ENGINE
  CODEX_BIN, CLAUDE_BIN, ANTIGRAVITY_BIN
  CODEX_MODEL, CLAUDE_MODEL, ANTIGRAVITY_MODEL
  CODEX_EFFORT, CLAUDE_EFFORT, ANTIGRAVITY_EFFORT
  CODEX_EXTRA_ARGS, CLAUDE_EXTRA_ARGS, ANTIGRAVITY_EXTRA_ARGS
  SUMMARY_ENGINE      engine used for summary
                      (default: selected engine; codex for all)

Examples:
  casual-review review --engine claude --base origin/master --head HEAD
  casual-review review --engine claude --model claude-sonnet-5
  casual-review review --engine all --limit 3
USAGE
}

[[ -n "${CASUAL_REVIEW_ROOT:-}" ]] || {
  printf 'Error: run this command through casual-review\n' >&2
  exit 1
}

# shellcheck source=lib/casual-review/common.sh
# shellcheck disable=SC1091
source "$CASUAL_REVIEW_ROOT/lib/casual-review/common.sh"

# *_MODEL_RESOLVED / *_EFFORT_RESOLVED are populated by run_codex/run_claude
# from the engine's own output after its first successful call this run, so
# these report the real value even when no --model/--effort/env override was
# given. Unset until then, so callers fall back to what was requested.
engine_model() {
  case "$1" in
    codex) printf '%s' "${CODEX_MODEL_RESOLVED:-${CODEX_MODEL:-default}}" ;;
    claude) printf '%s' "${CLAUDE_MODEL_RESOLVED:-${CLAUDE_MODEL:-default}}" ;;
    antigravity) printf '%s' "${ANTIGRAVITY_MODEL:-default}" ;;
  esac
}

engine_effort() {
  case "$1" in
    codex) printf '%s' "${CODEX_EFFORT_RESOLVED:-${CODEX_EFFORT:-default}}" ;;
    claude) printf '%s' "${CLAUDE_EFFORT:-default}" ;;
    antigravity) printf '%s' "${ANTIGRAVITY_EFFORT:-default}" ;;
  esac
}

PACKAGE_DIR=$CASUAL_REVIEW_ROOT
ENGINE=${CASUAL_REVIEW_ENGINE:-codex}
BASE_REF=
BASE_REF_SET=0
HEAD_REF=HEAD
OUTPUT_DIR=ai-reviews
PROMPT_FILE="$PACKAGE_DIR/prompts/commit-review.md"
SUMMARY_PROMPT="$PACKAGE_DIR/prompts/summary.md"
LIMIT=0
DO_SUMMARY=1
MODEL_OPT=""
EFFORT_OPT=""
USE_CREDITS=0

while (($#)); do
  case "$1" in
    --engine)
      cli_require_value "$1" "${2-}" "$#"
      ENGINE=$2
      shift 2
      ;;
    --base)
      cli_require_value "$1" "${2-}" "$#"
      BASE_REF=$2
      BASE_REF_SET=1
      shift 2
      ;;
    --head)
      cli_require_value "$1" "${2-}" "$#"
      HEAD_REF=$2
      shift 2
      ;;
    --output)
      cli_require_value "$1" "${2-}" "$#"
      OUTPUT_DIR=$2
      shift 2
      ;;
    --prompt)
      cli_require_value "$1" "${2-}" "$#"
      PROMPT_FILE=$2
      shift 2
      ;;
    --limit)
      cli_require_value "$1" "${2-}" "$#"
      LIMIT=$2
      shift 2
      ;;
    --model)
      cli_require_value "$1" "${2-}" "$#"
      MODEL_OPT=$2
      shift 2
      ;;
    --effort)
      cli_require_value "$1" "${2-}" "$#"
      EFFORT_OPT=$2
      shift 2
      ;;
    --use-credits) USE_CREDITS=1; shift ;;
    --skip-summary) DO_SUMMARY=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

cli_validate_engine "$ENGINE" 1
cli_validate_limit "$LIMIT"

if [[ -n "$MODEL_OPT" || -n "$EFFORT_OPT" ]]; then
  [[ "$ENGINE" != all ]] || die \
    "--model/--effort require a single --engine (not 'all');" \
    "use CODEX_MODEL/CLAUDE_MODEL/ANTIGRAVITY_MODEL and" \
    "CODEX_EFFORT/CLAUDE_EFFORT/ANTIGRAVITY_EFFORT instead"
  apply_engine_overrides "$ENGINE" "$MODEL_OPT" "$EFFORT_OPT"
fi

# Default: strip known API-key env vars so engines fall back to their
# plan/subscription auth instead of silently billing via metered API
# credits. --use-credits leaves them in place.
if ((USE_CREDITS == 0)); then
  strip_api_credit_env
fi

need git
[[ -r "$PROMPT_FILE" ]] || die "prompt not readable: $PROMPT_FILE"
[[ -r "$SUMMARY_PROMPT" ]] || die "summary prompt not readable: $SUMMARY_PROMPT"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  die "run inside a Git repository"
if ((BASE_REF_SET == 0)); then
  origin_head=$(git symbolic-ref --quiet --short \
    refs/remotes/origin/HEAD 2>/dev/null || :)
  case "$origin_head" in
    origin/master|origin/main)
      if git rev-parse --verify \
          "${origin_head}^{commit}" >/dev/null 2>&1; then
        BASE_REF=$origin_head
      fi
      ;;
  esac
  if [[ -z "$BASE_REF" ]] &&
      git rev-parse --verify "origin/master^{commit}" >/dev/null 2>&1; then
    BASE_REF=origin/master
  elif [[ -z "$BASE_REF" ]] &&
      git rev-parse --verify "origin/main^{commit}" >/dev/null 2>&1; then
    BASE_REF=origin/main
  fi
  [[ -n "$BASE_REF" ]] ||
    die "could not detect base: origin/master and origin/main are missing;" \
      "use --base REF"
fi
git rev-parse --verify "${BASE_REF}^{commit}" >/dev/null 2>&1 ||
  die "invalid base: $BASE_REF"
git rev-parse --verify "${HEAD_REF}^{commit}" >/dev/null 2>&1 ||
  die "invalid head: $HEAD_REF"

REPO_ROOT=$(git rev-parse --show-toplevel)
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR=$(cd "$OUTPUT_DIR" && pwd)

COMMITS=()
while IFS= read -r line; do
  COMMITS+=("$line")
done < <(git rev-list --reverse --topo-order "${BASE_REF}..${HEAD_REF}")
if ((LIMIT > 0 && ${#COMMITS[@]} > LIMIT)); then
  COMMITS=("${COMMITS[@]:0:LIMIT}")
fi
((${#COMMITS[@]})) || { echo "No commits in $BASE_REF..$HEAD_REF"; exit 0; }

if git rev-list --min-parents=2 "${BASE_REF}..${HEAD_REF}" | grep -q .; then
  printf '%s%s\n' \
    'Warning: range contains merge commits; each merge is reviewed ' \
    'against its first parent.' >&2
fi

run_codex() {
  local prompt=$1 output=$2
  local bin=${CODEX_BIN:-codex}; need "$bin"
  build_engine_arg_arrays codex
  # codex prints "model: ..." / "reasoning effort: ..." to stderr at startup;
  # capture it to recover the real values even when neither was overridden.
  local err_tmp status=0
  err_tmp=$(mktemp) || return 1
  "$bin" exec --ephemeral --sandbox read-only -C "$REPO_ROOT" \
    "${ENGINE_MODEL_ARGS[@]}" \
    "${ENGINE_EFFORT_ARGS[@]}" \
    "${ENGINE_EXTRA_ARGS[@]}" \
    -o "$output" - <"$prompt" >/dev/null 2>"$err_tmp" || status=$?
  cat "$err_tmp" >&2
  local resolved
  resolved=$(grep -m1 '^model: ' "$err_tmp" | sed 's/^model: *//')
  [[ -z "$resolved" ]] || CODEX_MODEL_RESOLVED=$resolved
  resolved=$(
    grep -m1 '^reasoning effort: ' "$err_tmp" |
      sed 's/^reasoning effort: *//'
  )
  [[ -z "$resolved" ]] || CODEX_EFFORT_RESOLVED=$resolved
  rm -f "$err_tmp"
  return "$status"
}

run_claude() {
  local prompt=$1 output=$2
  local bin=${CLAUDE_BIN:-claude}; need "$bin"
  need jq
  build_engine_arg_arrays claude
  # --output-format json exposes modelUsage, letting us recover the real
  # model even when it wasn't overridden; it does not expose effort.
  local json_tmp output_tmp resolved status=0
  json_tmp=$(mktemp) || return 1
  (
    cd "$REPO_ROOT"
    "$bin" -p --no-session-persistence --permission-mode dontAsk \
      --output-format json \
      --tools 'Read,Bash' \
      --allowedTools 'Read' \
      'Bash(git diff *)' 'Bash(git show *)' 'Bash(git log *)' \
      'Bash(git rev-parse *)' 'Bash(git cat-file *)' \
      "${ENGINE_MODEL_ARGS[@]}" \
      "${ENGINE_EFFORT_ARGS[@]}" \
      "${ENGINE_EXTRA_ARGS[@]}" \
      <"$prompt" >"$json_tmp"
  ) || status=$?
  if ((status == 0)); then
    output_tmp=$(mktemp "$output.tmp.XXXXXX") || status=1
  fi
  if ((status == 0)); then
    replace_file_from_command "$output" "$output_tmp" \
      jq -r '.result' "$json_tmp" || status=1
  fi
  if ((status == 0)); then
    resolved=$(
      jq -r '
        .modelUsage
        | to_entries
        | if length > 0
          then (max_by(.value.outputTokens) | .key)
          else empty
          end
      ' "$json_tmp" 2>/dev/null
    )
    [[ -z "$resolved" ]] || CLAUDE_MODEL_RESOLVED=$resolved
  fi
  rm -f "$json_tmp"
  [[ -z "${output_tmp:-}" ]] || rm -f "$output_tmp"
  return "$status"
}

run_antigravity() {
  local prompt=$1 output=$2
  local bin=${ANTIGRAVITY_BIN:-antigravity}; need "$bin"
  build_engine_arg_arrays antigravity
  (
    cd "$REPO_ROOT"
    "$bin" -p "$(cat "$prompt")" \
      "${ENGINE_MODEL_ARGS[@]}" \
      "${ENGINE_EFFORT_ARGS[@]}" \
      "${ENGINE_EXTRA_ARGS[@]}" \
      >"$output"
  )
}

run_engine() {
  local engine=$1 prompt=$2 output=$3
  case "$engine" in
    codex) run_codex "$prompt" "$output" ;;
    claude) run_claude "$prompt" "$output" ;;
    antigravity) run_antigravity "$prompt" "$output" ;;
  esac
}

engines=()
if [[ "$ENGINE" == all ]]; then
  engines=(codex claude antigravity)
else
  engines=("$ENGINE")
fi

INDEX="$OUTPUT_DIR/README.md"
FAILURES="$OUTPUT_DIR/failures.tsv"
ROWS="$OUTPUT_DIR/.rows.tmp"
: >"$FAILURES"
: >"$ROWS"

n=0
for commit in "${COMMITS[@]}"; do
  n=$((n+1))
  parent=$(git rev-parse "${commit}^1")
  short=$(git rev-parse --short=12 "$commit")
  subject=$(git log -1 --format=%s "$commit")
  safe_subject=$(printf '%s' "$subject" | sed 's/[&/]/\\&/g')
  for engine in "${engines[@]}"; do
    dir="$OUTPUT_DIR/$engine"; mkdir -p "$dir"
    output="$dir/$(printf '%03d' "$n")-$short.md"
    tmp=$(mktemp) || exit 1
    trap 'rm -f "$tmp"' EXIT
    write_file_from_command "$tmp" \
      sed -e "s/{{COMMIT}}/$commit/g" \
        -e "s/{{PARENT}}/$parent/g" \
        -e "s/{{SUBJECT}}/$safe_subject/g" \
        "$PROMPT_FILE"
    printf '[%d/%d] %-11s %s %s\n' \
      "$n" "${#COMMITS[@]}" "$engine" "$short" "$subject"
    if run_engine "$engine" "$tmp" "$output"; then result=OK; else
      result=FAILED
      printf '%s\t%s\t%s\t%s\n' \
        "$engine" "$commit" "$short" "$subject" >>"$FAILURES"
      printf "# Review failed\n\nEngine: %s  \nCommit: \`%s\`\n" \
        "$engine" "$commit" >"$output"
    fi
    printf '\n---\n_Engine: %s · Model: %s · Effort: %s_\n' \
      "$engine" \
      "$(engine_model "$engine")" \
      "$(engine_effort "$engine")" \
      >>"$output"
    escaped=${subject//|/\\|}
    rel="$engine/$(basename "$output")"
    printf "| %d | \`%s\` | %s | %s | [%s](%s) |\n" \
      "$n" "$short" "$escaped" "$engine" "$result" "$rel" >>"$ROWS"
    rm -f "$tmp"; trap - EXIT
  done
done

# Written after the loop so the engine-config lines below reflect the real
# resolved model/effort (populated by run_codex/run_claude on their first
# successful call), not just the pre-run "default" placeholder.
engine_config_lines=""
for e in "${engines[@]}"; do
  engine_config_lines+="- ${e} model: $(engine_model "$e") · "
  engine_config_lines+="effort: $(engine_effort "$e")"$'\n'
done
{
  cat <<EOF2
# AI-assisted Gerrit commit reviews

- Base: \`$BASE_REF\`
- Head: \`$HEAD_REF\`
- Engines: ${engines[*]}
- Commits: ${#COMMITS[@]}
${engine_config_lines}
| # | Commit | Subject | Engine | Result |
|---:|---|---|---|---|
EOF2
  cat "$ROWS"
} >"$INDEX"
rm -f "$ROWS"

make_summary() {
  local engine=${SUMMARY_ENGINE:-}
  if [[ -z "$engine" ]]; then
    [[ "$ENGINE" == all ]] && engine=codex || engine=$ENGINE
  fi
  local tmp
  tmp=$(mktemp) || return 1
  write_file_from_command "$tmp" \
    sed "s|{{REVIEW_DIR}}|$OUTPUT_DIR|g" "$SUMMARY_PROMPT" || return 1
  if run_engine "$engine" "$tmp" "$OUTPUT_DIR/SUMMARY.md"; then
    printf '\n---\n_Engine: %s · Model: %s · Effort: %s_\n' \
      "$engine" \
      "$(engine_model "$engine")" \
      "$(engine_effort "$engine")" \
      >>"$OUTPUT_DIR/SUMMARY.md"
    printf '\nSummary: %s (generated with %s)\n' \
      "$OUTPUT_DIR/SUMMARY.md" "$engine"
  else
    printf 'Warning: summary generation failed with %s\n' "$engine" >&2
  fi
  rm -f "$tmp"
}

((DO_SUMMARY == 0)) || make_summary
printf 'Index: %s\n' "$INDEX"
if [[ -s "$FAILURES" ]]; then
  printf 'Some reviews failed; see %s\n' "$FAILURES" >&2
  exit 1
fi
