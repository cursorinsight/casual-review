#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  casual-review process [options] [REVIEWS_DIR]

Options:
  --engine NAME     codex, claude, or antigravity
                    (default: CASUAL_REVIEW_ENGINE or codex)
  --reviews DIR     generated review directory (default: ai-reviews)
  --prompt FILE     prompt template (default: prompts/process-reviews.md)
  --model NAME      model override for the selected engine
  --effort LEVEL    reasoning-effort override for the selected engine
  --use-credits     allow metered API-credit billing
  -h, --help        show help

Environment overrides:
  CASUAL_REVIEW_ENGINE
  CODEX_BIN, CLAUDE_BIN, ANTIGRAVITY_BIN
  CODEX_MODEL, CLAUDE_MODEL, ANTIGRAVITY_MODEL
  CODEX_EFFORT, CLAUDE_EFFORT, ANTIGRAVITY_EFFORT
  CODEX_EXTRA_ARGS, CLAUDE_EXTRA_ARGS, ANTIGRAVITY_EXTRA_ARGS
USAGE
}

[[ -n "${CASUAL_REVIEW_ROOT:-}" ]] || {
  printf 'Error: run this command through casual-review\n' >&2
  exit 1
}

# shellcheck source=lib/casual-review/common.sh
# shellcheck disable=SC1091
source "$CASUAL_REVIEW_ROOT/lib/casual-review/common.sh"

cleanup() {
  if [[ -n "${PROMPT_TMP:-}" ]]; then
    rm -f -- "$PROMPT_TMP"
  fi
}

trap cleanup EXIT

PACKAGE_DIR=$CASUAL_REVIEW_ROOT
ENGINE=${CASUAL_REVIEW_ENGINE:-codex}
REVIEWS_DIR=ai-reviews
PROMPT_FILE=$PACKAGE_DIR/prompts/process-reviews.md
MODEL_OPT=
EFFORT_OPT=
USE_CREDITS=0
PROMPT_TMP=
REPO_ROOT=
REVIEWS_DIR_ABS=

while (($#)); do
  case "$1" in
    --engine)
      cli_require_value "$1" "${2-}" "$#"
      ENGINE=$2
      shift 2
      ;;
    --reviews)
      cli_require_value "$1" "${2-}" "$#"
      REVIEWS_DIR=$2
      shift 2
      ;;
    --prompt)
      cli_require_value "$1" "${2-}" "$#"
      PROMPT_FILE=$2
      shift 2
      ;;
    --model)
      cli_require_value "$1" "${2-}" "$#"
      MODEL_OPT=$2
      shift 2
      ;;
    --effort)
      cli_require_value "$1" "${2-}" "$#"
      EFFORT_OPT=$2
      shift 2
      ;;
    --use-credits)
      USE_CREDITS=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ "$REVIEWS_DIR" == ai-reviews ]] ||
        die "only one reviews directory is supported"
      REVIEWS_DIR=$1
      shift
      ;;
  esac
done

cli_validate_engine "$ENGINE"

apply_engine_overrides "$ENGINE" "$MODEL_OPT" "$EFFORT_OPT"

if ((USE_CREDITS == 0)); then
  strip_api_credit_env
fi

need git
[[ -r "$PROMPT_FILE" ]] || die "prompt not readable: $PROMPT_FILE"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  die "run inside a Git repository"

REPO_ROOT=$(git rev-parse --show-toplevel)
if [[ -d "$REVIEWS_DIR" ]]; then
  REVIEWS_DIR_ABS=$(CDPATH='' cd -- "$REVIEWS_DIR" && pwd -P)
elif [[ "$REVIEWS_DIR" != /* && -d "$REPO_ROOT/$REVIEWS_DIR" ]]; then
  REVIEWS_DIR_ABS=$(CDPATH='' cd -- "$REPO_ROOT/$REVIEWS_DIR" && pwd -P)
else
  die "not a directory: $REVIEWS_DIR"
fi
PROMPT_TMP=$(mktemp)

{
  printf 'Use these explicit inputs unless the user corrects them:\n\n'
  printf -- "- Review directory: \`%s\`\n" "$REVIEWS_DIR_ABS"
  printf -- "- Decision log: \`%s/DECISIONS.md\`\n\n" "$REVIEWS_DIR_ABS"
  printf 'Do not use a different review directory without asking.\n\n'
  cat "$PROMPT_FILE"
} >"$PROMPT_TMP"

reviews_outside_repo() {
  case "$REVIEWS_DIR_ABS/" in
    "$REPO_ROOT"/*) return 1 ;;
    *) return 0 ;;
  esac
}

run_codex() {
  local bin=${CODEX_BIN:-codex}
  local -a add_dir=()

  need "$bin"
  build_engine_arg_arrays codex
  reviews_outside_repo && add_dir=(--add-dir "$REVIEWS_DIR_ABS")
  "$bin" \
    -C "$REPO_ROOT" \
    --sandbox workspace-write \
    "${ENGINE_MODEL_ARGS[@]}" \
    "${ENGINE_EFFORT_ARGS[@]}" \
    "${add_dir[@]}" \
    "${ENGINE_EXTRA_ARGS[@]}" \
    "$(cat "$PROMPT_TMP")"
}

run_claude() {
  local bin=${CLAUDE_BIN:-claude}

  need "$bin"
  build_engine_arg_arrays claude
  (
    cd "$REPO_ROOT"
    "$bin" \
      "${ENGINE_MODEL_ARGS[@]}" \
      "${ENGINE_EFFORT_ARGS[@]}" \
      "${ENGINE_EXTRA_ARGS[@]}" \
      "$(cat "$PROMPT_TMP")"
  )
}

run_antigravity() {
  local bin=${ANTIGRAVITY_BIN:-antigravity}
  local -a add_dir=()

  need "$bin"
  build_engine_arg_arrays antigravity
  reviews_outside_repo && add_dir=(--add-dir "$REVIEWS_DIR_ABS")
  (
    cd "$REPO_ROOT"
    "$bin" \
      --mode accept-edits \
      --prompt-interactive \
      "${ENGINE_MODEL_ARGS[@]}" \
      "${ENGINE_EFFORT_ARGS[@]}" \
      "${add_dir[@]}" \
      "${ENGINE_EXTRA_ARGS[@]}" \
      "$(cat "$PROMPT_TMP")"
  )
}

case "$ENGINE" in
  codex) run_codex ;;
  claude) run_claude ;;
  antigravity) run_antigravity ;;
esac
